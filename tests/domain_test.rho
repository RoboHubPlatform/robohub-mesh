module mesh.domain_test

include "../src/mesh/domain/plan_text.rho"
include "../src/mesh/domain/transport.rho"
include "../src/mesh/domain/impact.rho"
include "../src/mesh/domain/deploy.rho"
include "../src/mesh/domain/manifest.rho"
include "../src/mesh/domain/production.rho"

// Unit tests for Mesh's domain: the plan as text, the transport rule and the
// impact table. None of it reads a file, a registry or a board, which is what
// lets it be tested here rather than through the pages.

extern fn abort()

fn check(condition: bool, what: string) void {
    if !condition {
        print("FAIL: " + what + "\n")
        abort()
    }
}

/* -------------------------------------------------------------------------- */
/*  The plan as text                                                          */
/* -------------------------------------------------------------------------- */

test fn a_parent_is_stored_by_number_and_read_by_row() void {
    let view: string = "node.count=2\nnode.1.name=Relay\nnode.1.parent=gateway\nnode.2.name=Leaf\nnode.2.parent=node.1\n"
    let stored: string = plan_stored(view)
    check(str_eq(plan_value(stored, "node.1.number"), "1"), "a node planned before numbers keeps its row number")
    check(str_eq(plan_value(stored, "node.2.number"), "2"), "the second keeps its row number too")
    check(str_eq(plan_value(stored, "node.2.parent_node"), "1"), "the parent is stored by its number")
    check(str_eq(plan_value(stored, "node.2.parent"), ""), "the row form is not stored")
    check(str_eq(plan_value(stored, "node.1.parent"), "gateway"), "the gateway is stored as it is")
    check(str_eq(plan_value(stored, "node.next_number"), "3"), "the counter is past every number")
    let back: string = plan_view(stored)
    check(str_eq(plan_value(back, "node.2.parent"), "node.1"), "the pages read the row form")
    print("[PASS] a_parent_is_stored_by_number_and_read_by_row\n")
}

test fn a_parent_follows_its_number_when_rows_move() void {
    // Node 2 is number 7 and its child names it; after node 1 goes, it is row 1.
    let stored: string = "node.count=3\nnode.1.number=1\nnode.2.number=7\nnode.3.number=8\nnode.3.parent_node=7\nnode.next_number=9\n"
    let removed: string = plan_text_remove_node(plan_view(stored), 1)
    check(str_eq(plan_value(removed, "node.count"), "2"), "the count falls by one")
    check(str_eq(plan_value(removed, "node.1.number"), "7"), "the second node is the first row, with its number")
    check(str_eq(plan_value(removed, "node.2.parent"), "node.1"), "its child names its new row")
    check(str_eq(plan_value(plan_stored(removed), "node.2.parent_node"), "7"), "and stores the same number")
    print("[PASS] a_parent_follows_its_number_when_rows_move\n")
}

test fn removing_a_node_sends_its_children_to_the_gateway() void {
    let view: string = "node.count=3\nnode.1.number=1\nnode.2.number=2\nnode.2.parent=node.1\nnode.3.number=3\nnode.3.parent=node.2\nstatus.node.2=built\nstatus.node.3=flashed\n"
    let removed: string = plan_text_remove_node(view, 2)
    check(str_eq(plan_value(removed, "node.2.number"), "3"), "the row after moves up with its number")
    check(str_eq(plan_value(removed, "node.2.parent"), "gateway"), "a child of the removed node goes to the gateway")
    check(str_eq(plan_value(removed, "status.node.2"), "flashed"), "a status moves with its row")
    check(str_eq(plan_value(removed, "node.3.number"), ""), "the last row is gone")
    print("[PASS] removing_a_node_sends_its_children_to_the_gateway\n")
}

test fn a_new_node_never_takes_a_number_that_was_used() void {
    // Numbers 1 and 2 were given, node 2 was removed; the new row 2 gets 3.
    let view: string = "node.count=2\nnode.1.number=1\nnode.2.name=New\nnode.next_number=3\n"
    let stored: string = plan_stored(view)
    check(str_eq(plan_value(stored, "node.2.number"), "3"), "the next number never used")
    check(str_eq(plan_value(stored, "node.next_number"), "4"), "and the counter moves past it")
    print("[PASS] a_new_node_never_takes_a_number_that_was_used\n")
}

test fn a_key_is_replaced_not_repeated() void {
    let text: string = plan_without("a=1\nb=2\nab=3\n", "a") + "a=4\n"
    check(str_eq(plan_value(text, "a"), "4"), "the new value")
    check(str_eq(plan_value(text, "ab"), "3"), "a longer key with the same start is kept")
    print("[PASS] a_key_is_replaced_not_repeated\n")
}

/* -------------------------------------------------------------------------- */
/*  Transports                                                                */
/* -------------------------------------------------------------------------- */

test fn a_transport_fits_what_both_boards_are() void {
    let pico: BoardCaps = BoardCaps{ "", false, true, false, "uart i2c spi" }
    let uno: BoardCaps = BoardCaps{ "", false, false, false, "uart i2c" }
    let host: BoardCaps = BoardCaps{ "", true, true, true, "" }
    check(transport_fits("wifi", pico, pico), "two wireless boards share wifi")
    check(!transport_fits("wifi", pico, uno), "a board without radio has no wifi")
    check(transport_fits("uart", pico, uno), "a bus both have")
    check(!transport_fits("spi", pico, uno), "a bus only one has")
    check(transport_fits("socket", host, pico), "a host and a wireless board share a socket")
    check(transport_fits("console", host, pico), "a host serves a console")
    check(!transport_fits("console", pico, uno), "a board that is not a host serves none")
    print("[PASS] a_transport_fits_what_both_boards_are\n")
}

test fn declared_links_are_the_whole_answer() void {
    let gateway: BoardCaps = BoardCaps{ "uart console", true, true, false, "" }
    let relay: BoardCaps = BoardCaps{ "uart wifi", false, true, false, "" }
    check(transport_fits("uart", gateway, relay), "a link both declare")
    check(!transport_fits("wifi", gateway, relay), "a link one does not declare, whatever its radio")
    check(!transport_fits("console", gateway, relay), "a console the child does not declare")
    print("[PASS] declared_links_are_the_whole_answer\n")
}

/* -------------------------------------------------------------------------- */
/*  The impact table                                                          */
/* -------------------------------------------------------------------------- */

test fn a_build_depends_on_structure_not_on_names() void {
    check(impact_structural("board"), "a board is built for")
    check(impact_structural("parent"), "a parent is linked to")
    check(impact_structural("module"), "a module is compiled in")
    check(!impact_structural("name"), "a name is not")
    check(!impact_structural("description"), "nor a description")
    check(!impact_structural("address"), "nor a device's address")
    print("[PASS] a_build_depends_on_structure_not_on_names\n")
}

test fn reopening_a_stage_reopens_every_later_one() void {
    check(str_eq(impact_steps("topology"), "step_network step_build step_verify"), "after the topology")
    check(str_eq(impact_steps("network"), "step_build step_verify"), "after the network")
    check(str_eq(impact_steps("build"), "step_verify"), "after the build")
    check(str_eq(impact_steps("verify"), ""), "nothing after the last")
    check(impact_resets_builds("topology") && impact_resets_builds("network") && !impact_resets_builds("build"),
        "a new topology or network is built again")
    print("[PASS] reopening_a_stage_reopens_every_later_one\n")
}

/* -------------------------------------------------------------------------- */
/*  What a board was built from                                               */
/* -------------------------------------------------------------------------- */

// A gateway with a Pico on UART that carries a temperature module, and a plug.
const DEPLOY_PLAN: string = "gateway=native\nnode.count=3\n" +
    "node.1.kind=compute\nnode.1.number=1\nnode.1.name=Relay\nnode.1.board=pico2w\nnode.1.role=node\nnode.1.parent=gateway\nnode.1.link=uart\nnode.1.baud=115200\n" +
    "node.2.kind=module\nnode.2.number=2\nnode.2.module=ds18b20\nnode.2.parent=node.1\n" +
    "node.3.kind=device\nnode.3.number=3\nnode.3.device=shelly\nnode.3.address=192.0.2.5\nnode.3.parent=gateway\n"

fn deploy_with(text: string, key: string, value: string) string {
    return plan_without(text, key) + key + "=" + value + "\n"
}

test fn a_name_or_a_device_builds_nothing() void {
    let before: string = deploy_node_signature(DEPLOY_PLAN, 1)
    let renamed: string = deploy_with(DEPLOY_PLAN, "node.1.name", "Greenhouse relay")
    check(str_eq(deploy_node_signature(renamed, 1), before), "a new name is not in the image")
    let readdressed: string = deploy_with(DEPLOY_PLAN, "node.3.address", "192.0.2.9")
    check(str_eq(deploy_node_signature(readdressed, 1), before), "a device's address is not either")
    check(str_eq(deploy_gateway_signature(readdressed), deploy_gateway_signature(DEPLOY_PLAN)),
        "nor is it in the gateway's")
    print("[PASS] a_name_or_a_device_builds_nothing\n")
}

test fn a_module_or_a_board_rebuilds_that_board() void {
    let before: string = deploy_node_signature(DEPLOY_PLAN, 1)
    let new_module: string = deploy_with(DEPLOY_PLAN, "node.2.module", "bme280")
    check(str_eq(deploy_reason(before, deploy_node_signature(new_module, 1)), "modules changed"), "a new module")
    let board: string = deploy_with(DEPLOY_PLAN, "node.1.board", "lolin32-lite")
    check(str_eq(deploy_reason(before, deploy_node_signature(board, 1)), "board changed"), "a new board")
    check(str_eq(deploy_gateway_signature(board), deploy_gateway_signature(DEPLOY_PLAN)),
        "the gateway does not care which board is on the other end")
    print("[PASS] a_module_or_a_board_rebuilds_that_board\n")
}

test fn a_link_rebuilds_the_board_and_restarts_its_parent() void {
    let before: string = deploy_node_signature(DEPLOY_PLAN, 1)
    let baud: string = deploy_with(DEPLOY_PLAN, "node.1.baud", "57600")
    check(str_eq(deploy_reason(before, deploy_node_signature(baud, 1)), "link changed"), "the board's own link")
    check(str_eq(deploy_reason(deploy_gateway_signature(DEPLOY_PLAN), deploy_gateway_signature(baud)),
        "a link it serves changed"), "the gateway serving it restarts")
    print("[PASS] a_link_rebuilds_the_board_and_restarts_its_parent\n")
}

test fn a_board_on_wifi_follows_the_gateway_address() void {
    let wifi: string = deploy_with(DEPLOY_PLAN, "node.1.link", "wifi")
    let before: string = deploy_node_signature(wifi, 1)
    let moved: string = deploy_with(wifi, "gateway_host", "192.0.2.20")
    check(str_eq(deploy_reason(before, deploy_node_signature(moved, 1)), "gateway address changed"),
        "a board that dials the gateway is rebuilt when it moves")
    let serial_moved: string = deploy_with(DEPLOY_PLAN, "gateway_host", "192.0.2.20")
    check(str_eq(deploy_node_signature(serial_moved, 1), deploy_node_signature(DEPLOY_PLAN, 1)),
        "a board on a serial line is not")
    print("[PASS] a_board_on_wifi_follows_the_gateway_address\n")
}

test fn a_board_never_programmed_says_so() void {
    check(str_eq(deploy_reason("", deploy_node_signature(DEPLOY_PLAN, 1)), "never programmed"), "nothing recorded")
    check(str_eq(deploy_reason(deploy_node_signature(DEPLOY_PLAN, 1), deploy_node_signature(DEPLOY_PLAN, 1)), ""),
        "what was programmed is what is planned")
    check(deploy_is_board(DEPLOY_PLAN, 1) && !deploy_is_board(DEPLOY_PLAN, 2) && !deploy_is_board(DEPLOY_PLAN, 3),
        "modules and devices have no image of their own")
    print("[PASS] a_board_never_programmed_says_so\n")
}

test fn the_diff_names_what_changed_and_how() void {
    let before: string = deploy_node_signature(DEPLOY_PLAN, 1)
    let after: string = deploy_node_signature(deploy_with(DEPLOY_PLAN, "node.1.board", "lolin32-lite"), 1)
    let diff: string = deploy_diff(before, after)
    check(str_eq(diff, "board|pico2w|lolin32-lite\n"), "one segment, from what runs to what is planned")
    check(str_eq(deploy_diff(before, before), ""), "nothing differs, nothing listed")
    print("[PASS] the_diff_names_what_changed_and_how\n")
}

/* -------------------------------------------------------------------------- */
/*  The node manifest                                                         */
/* -------------------------------------------------------------------------- */

const MANIFEST_PLAN: string = "node.count=5\n" +
    "node.1.id=0123456789abcdef\nnode.1.number=4\nnode.1.role=relay\nnode.1.kind=compute\n" +
    "node.2.id=1111222233334444\nnode.2.number=9\nnode.2.role=node\nnode.2.revoked=1\n" +
    "node.3.id=aaaabbbbccccdddd\nnode.3.kind=module\nnode.3.role=module\n" +
    "node.4.id=5555666677778888\nnode.4.kind=device\n" +
    "node.5.number=12\nnode.5.role=node\n"

test fn the_manifest_lists_every_board_with_its_placement() void {
    let lines: string = manifest_nodes(MANIFEST_PLAN, "3")
    check(str_eq(manifest_find(lines, "0123456789abcdef"), "0123456789abcdef|3|4|relay|0|0|"),
        "a relay is listed with its area, number and role, announcing nothing")
    check(str_eq(manifest_find(lines, "1111222233334444"), "1111222233334444|3|9|board|0|1|"),
        "a revoked board is listed as revoked")
    check(str_eq(manifest_find(lines, "aaaabbbbccccdddd"), ""), "a module opens no session and is not listed")
    check(str_eq(manifest_find(lines, "5555666677778888"), ""), "a device is not listed")
    check(str_index_of(lines, "|12|") < 0, "a board without an id has no key and no line")
    let document: string = manifest_document(lines, manifest_relay_line("9999aaaabbbbcccc", "07", "7,8"))
    check(str_index_of(document, "#") == 0, "the file starts with what it is")
    check(str_eq(manifest_find(document, "9999aaaabbbbcccc"), "9999aaaabbbbcccc|7|0|relay|0|0|7,8"),
        "a mesh linked below is a relay for its areas")
    check(str_eq(manifest_relay_line("not-an-id", "7", "7"), ""), "a relay without an id has no line")
    check(str_eq(manifest_areas_add(manifest_areas_add("7", "8"), "7"), "7,8"), "an area is listed once")
    check(!manifest_uid_ok("0123456789ABCDEF"), "an id is lowercase hex")
    print("[PASS] the_manifest_lists_every_board_with_its_placement\n")
}

test fn a_rotated_board_is_listed_at_its_key_epoch() void {
    let plan: string = MANIFEST_PLAN + "node.1.epoch=3\nnode.5.epoch=junk\n"
    let lines: string = manifest_nodes(plan, "3")
    check(str_eq(manifest_find(lines, "0123456789abcdef"), "0123456789abcdef|3|4|relay|3|0|"),
        "a rotated node is listed at its epoch")
    check(manifest_node_epoch(plan, 2) == 0, "a node never rotated is at epoch 0")
    check(manifest_node_epoch(plan, 5) == 0, "an epoch that is not a number is 0")
    check(str_eq(manifest_key_message("0123456789abcdef", 0), "72682d646576310123456789abcdef"),
        "epoch 0 derives as rh-dev1 | uid")
    check(str_eq(manifest_key_message("0123456789abcdef", 258), "72682d646576320123456789abcdef02010000"),
        "a later epoch derives as rh-dev2 | uid | epoch, little-endian")
    print("[PASS] a_rotated_board_is_listed_at_its_key_epoch\n")
}

test fn a_rotation_waits_for_the_board_to_confirm() void {
    let report: string = "# uid|epoch|status|time\n0123456789abcdef|2|confirmed|100\n1111222233334444|1|cannot|200\n"
    check(str_eq(rekey_state(report, "aaaabbbbccccdddd", 0), ""), "a board never rotated has no state")
    check(str_eq(rekey_state(report, "aaaabbbbccccdddd", 1), "waiting"), "a rotated board the gateway has not heard is waiting")
    check(str_eq(rekey_state(report, "0123456789abcdef", 2), "confirmed"), "a board that confirmed its epoch is rotated")
    check(str_eq(rekey_state(report, "0123456789abcdef", 3), "waiting"), "and waits again once rotated further")
    check(str_eq(rekey_state(report, "1111222233334444", 1), "cannot"), "a board with no store cannot rotate")
    check(str_eq(rotate_refusal(report, "0123456789abcdef", 2), ""), "a confirmed board may be rotated again")
    check(str_eq(rotate_refusal(report, "0123456789abcdef", 3), "unconfirmed"), "an unconfirmed one may not")
    check(str_eq(rotate_refusal(report, "1111222233334444", 1), "cannot"), "nor one that cannot rotate")
    check(str_eq(rotate_refusal("", "aaaabbbbccccdddd", 0), ""), "a board at epoch 0 may be rotated")
    let api: string = "[{\"uid\":\"0123456789abcdef\",\"manifest_epoch\":2,\"confirmed\":2,\"epoch\":2,\"status\":\"confirmed\",\"time\":100}," +
        "{\"uid\":\"1111222233334444\",\"manifest_epoch\":1,\"confirmed\":-1,\"epoch\":1,\"status\":\"cannot\",\"time\":200}]"
    check(str_eq(rekey_from_json(api), "0123456789abcdef|2|confirmed|100\n1111222233334444|1|cannot|200\n"),
        "a remote gateway's keys read as rekey.txt lines")
    print("[PASS] a_rotation_waits_for_the_board_to_confirm\n")
}

/* -------------------------------------------------------------------------- */
/*  Production builds                                                         */
/* -------------------------------------------------------------------------- */

test fn the_production_toggle_shows_for_a_platform_with_a_plan() void {
    // The folders the platforms ship, as `ls <platform>/production` lists them.
    let esp32: string = "esp32.json\npartitions.production.csv\nproduction.conf\nsdkconfig.production\n"
    let pico: string = "production.conf\nrp2350.json\n"
    let stm32: string = "production.conf\nproduction.json\n"
    check(str_eq(production_candidates("Pico2W", "rp2350", ""), "pico2w.json\nrp2350.json\nproduction.json\n"),
        "a plan is looked up by target, preset, family and platform, in lowercase")
    check(str_eq(production_candidates("x", "x", "../y"), "x.json\nproduction.json\n"),
        "a repeated name or one with a path is skipped")
    check(production_available(esp32, "lolin32-lite", "esp32", ""), "an ESP32 board has a production mode, by its preset")
    check(production_available(pico, "pico2w", "rp2350", ""), "an RP2350 board has one, by its preset")
    check(!production_available(pico, "pico", "rp2040", ""), "an RP2040 board of the same platform has none")
    check(str_eq(production_plan_name(stm32, "nucleo-h753zi", "stm32h7", "STM32H7"), "production.json"),
        "an STM32 board has the platform's plan")
    check(!production_available("", "uno-r3", "atmega328p", ""), "an AVR board has no production folder, so no mode")
    check(!production_available("", "arduino-uno-q", "uno-q", "host"), "nor has a Linux host")
    check(!production_available("production.conf\n", "x", "y", ""), "a fragment alone is not a plan")
    let spec: string = "{\n  \"kind\": \"board\",\n  \"name\": \"pico2w\",\n  \"preset\" : \"rp2350\",\n  \"family\": \"STM32F4\"\n}"
    check(str_eq(production_json_string(spec, "preset"), "rp2350"), "a target spec's preset is read")
    check(str_eq(production_json_string(spec, "family"), "STM32F4"), "and its family")
    check(str_eq(production_json_string(spec, "mcu"), ""), "a field it does not have is empty")
    check(str_eq(production_platform_root("/w/robohub-pico/boards/pico2w/module.yml"), "/w/robohub-pico"),
        "a board's platform is the folder above boards/")
    check(str_eq(production_platform_root("module.yml"), ""), "a manifest outside boards/ has none")
    print("[PASS] the_production_toggle_shows_for_a_platform_with_a_plan\n")
}

test fn a_production_build_needs_the_key_its_plan_names() void {
    let esp32: string = "{\"build\": \"CONFIG_RH_PRODUCTION=y ..., RH_SECURE_BOOT_SIGNING_KEY naming the RSA-3072 PEM key.\"}"
    let pico: string = "{\"build\": \"RH_SECURE_BOOT_SIGNING_KEY ...\", \"steps\": [{\"command\": \"picotool otp load {env:RH_PICO_OTP_JSON}\"}]}"
    let stm32: string = "{\"build\": \"Any build\", \"steps\": [{\"command\": \"STM32_Programmer_CLI -ob RDP=0xBB\"}]}"
    check(production_needs_key(esp32) && !production_needs_otp(esp32), "an ESP32 plan needs the key and no OTP file")
    check(production_needs_key(pico) && production_needs_otp(pico), "an RP2350 plan needs both")
    check(!production_needs_key(stm32) && !production_needs_otp(stm32), "an STM32 plan needs neither")
    check(production_key_mode_ok("600") && production_key_mode_ok("400") && production_key_mode_ok("0600"), "an owner-only key is fine")
    check(!production_key_mode_ok("640") && !production_key_mode_ok("644") && !production_key_mode_ok("604") && !production_key_mode_ok(""),
        "a key the group or others can read is not")
    check(str_eq(production_key_refusal(true, "", false, ""), "missing"), "a production build is refused without a key")
    check(str_eq(production_key_refusal(true, "/k/esp.pem", false, ""), "missing"), "or with a key file that is not there")
    check(str_eq(production_key_refusal(true, "k/esp.pem", true, "600"), "relative"), "or one named by a relative path")
    check(str_eq(production_key_refusal(true, "/k/esp.pem", true, "644"), "open"), "or one others can read")
    check(str_eq(production_key_refusal(true, "/k/esp.pem", true, "600"), ""), "and queued with one in place")
    check(str_eq(production_key_refusal(false, "", false, ""), ""), "a plan that needs no key queues without one")
    print("[PASS] a_production_build_needs_the_key_its_plan_names\n")
}

test fn the_production_job_scripts() void {
    let dir: string = "/m/p/boards/node_3"
    let bin: string = dir + "/build/output/node_3.elf"
    let plain_build: string = production_build_script("pico2w", dir, bin, "node_3", false, "/k/key.pem", true, dir + "/plan.txt")
    check(str_eq(plain_build, "cd '/m/p/boards/node_3'\nrho build -target 'pico2w' .\n"),
        "a plain build is the build as it was, with no key and no plan")
    check(str_eq(production_flash_script("pico2w", dir, bin, "node_3", false, true),
        "rho flash -target 'pico2w' -project '/m/p/boards/node_3' '/m/p/boards/node_3/build/output/node_3.elf'\n"),
        "a plain flash is the flash as it was")
    let build: string = production_build_script("pico2w", dir, bin, "node_3", true, "/k/key.pem", true, dir + "/plan.txt")
    check(str_index_of(build, "export RH_SECURE_BOOT_SIGNING_KEY='/k/key.pem'\nrho build -target 'pico2w' .\n") >= 0,
        "a production build is given the key by its path before it builds")
    check(str_index_of(build, "export RH_PICO_OTP_JSON='/m/p/boards/node_3/build/output/node_3.otp.json'\n") >= 0,
        "an RP2350 build points the flash at the OTP file it wrote")
    check(str_index_of(build, "'/m/p/boards/node_3/build/output/node_3.elf' --production --dry-run > '/m/p/boards/node_3/plan.txt'\n") >= 0,
        "and ends by writing what the flash will do")
    let esp: string = production_build_script("lolin32-lite", dir, bin, "node_3", true, "/k/rsa.pem", false, dir + "/plan.txt")
    check(str_index_of(esp, "RH_PICO_OTP_JSON") < 0 && str_index_of(esp, "RH_SECURE_BOOT_SIGNING_KEY='/k/rsa.pem'") >= 0,
        "an ESP32 build has the key and no OTP file")
    let stm: string = production_build_script("nucleo-h753zi", dir, bin, "node_3", true, "", false, dir + "/plan.txt")
    check(str_index_of(stm, "RH_SECURE_BOOT_SIGNING_KEY") < 0 && str_index_of(stm, "--dry-run") >= 0,
        "an STM32 build has no key but still prints its plan")
    let flash: string = production_flash_script("pico2w", dir, bin, "node_3", true, true)
    check(str_index_of(flash, "if [ ! -s \"$confirm\" ]; then echo 'no board name was typed: nothing was run'; exit 1; fi\n") >= 0,
        "a production flash stops when no name was typed")
    check(str_index_of(flash, "export RH_PICO_OTP_JSON='/m/p/boards/node_3/build/output/node_3.otp.json'\n") >= 0,
        "an RP2350 flash names its OTP file")
    check(str_index_of(flash, "'/m/p/boards/node_3/build/output/node_3.elf' --production < \"$confirm\"\n") >= 0,
        "and runs rho flash --production with the typed name on its input")
    check(str_index_of(flash, "--dry-run") < 0, "the flash itself is not a dry run")
    check(str_index_of(production_flash_script("lolin32-lite", dir, bin, "node_3", true, false), "RH_PICO_OTP_JSON") < 0,
        "an ESP32 flash has no OTP file")
    check(str_eq(production_quote("it's"), "'it'\\''s'"), "a quote in a value stays one word")
    // The toggle is part of what a board is built from.
    let plan: string = "node.count=1\nnode.1.kind=compute\nnode.1.board=pico2w\nnode.1.parent=gateway\n"
    let plain: string = deploy_node_signature(plan, 1)
    check(str_index_of(plain, "production") < 0, "a board built plainly says nothing of production")
    check(str_eq(deploy_node_signature(plan + "node.1.production=off\n", 1), plain), "and one turned off is the same")
    let hardened: string = deploy_node_signature(plan + "node.1.production=on\n", 1)
    check(str_eq(deploy_reason(plain, hardened), "production build changed"), "turning it on makes the board out of date")
    print("[PASS] the_production_job_scripts\n")
}

test fn a_node_credential_is_read_from_its_header() void {
    let header: string = "Node gateway-node-01:00ff00ff00ff"
    check(str_eq(node_auth_part(header, 0), "gateway-node-01"), "the device")
    check(str_eq(node_auth_part(header, 1), "00ff00ff00ff"), "the credential")
    check(str_eq(node_auth_part("Bearer abc", 0), ""), "another scheme is not a node credential")
    check(str_eq(node_auth_part("Node :00ff", 0), ""), "a credential without a device")
    check(str_eq(node_auth_part("Node dev:", 1), ""), "a device without a credential")
    check(str_eq(node_auth_part("Node dev&x=1:00ff", 0), ""), "a device that would add a form field")
    check(str_eq(node_auth_part("Node dev:00ff&credential=1", 1), ""), "a credential that would add a form field")
    print("[PASS] a_node_credential_is_read_from_its_header\n")
}

test fn a_node_key_client_has_a_budget() void {
    check(str_eq(nodekey_client(""), "direct"), "a request to Mesh's own port")
    check(str_eq(nodekey_client("203.0.113.9, 192.168.1.20"), "192.168.1.20"), "the keeper proxy's entry")
    check(str_eq(nodekey_slot("192.168.1.20"), nodekey_slot("192.168.1.20")), "one client, one counter")
    var state: string = ""
    var i: u32 = 0
    while i < 10 {
        state = nodekey_count(state, 500, 60)
        i = i + 1
    }
    check(!nodekey_over(state, 10), "ten calls are within the budget")
    check(nodekey_over(nodekey_count(state, 530, 60), 10), "the eleventh is not")
    check(str_eq(nodekey_count(state, 560, 60), "1|560"), "a new window starts again")
    print("[PASS] a_node_key_client_has_a_budget\n")
}

fn main() void {
    a_parent_is_stored_by_number_and_read_by_row()
    a_parent_follows_its_number_when_rows_move()
    removing_a_node_sends_its_children_to_the_gateway()
    a_new_node_never_takes_a_number_that_was_used()
    a_key_is_replaced_not_repeated()
    a_transport_fits_what_both_boards_are()
    declared_links_are_the_whole_answer()
    a_build_depends_on_structure_not_on_names()
    reopening_a_stage_reopens_every_later_one()
    a_name_or_a_device_builds_nothing()
    a_module_or_a_board_rebuilds_that_board()
    a_link_rebuilds_the_board_and_restarts_its_parent()
    a_board_on_wifi_follows_the_gateway_address()
    a_board_never_programmed_says_so()
    the_diff_names_what_changed_and_how()
    the_manifest_lists_every_board_with_its_placement()
    a_rotated_board_is_listed_at_its_key_epoch()
    a_rotation_waits_for_the_board_to_confirm()
    the_production_toggle_shows_for_a_platform_with_a_plan()
    a_production_build_needs_the_key_its_plan_names()
    the_production_job_scripts()
    a_node_credential_is_read_from_its_header()
    a_node_key_client_has_a_budget()
    print("mesh domain tests ok\n")
}
