module mesh.domain_test

include "../src/mesh/domain/plan_text.rho"
include "../src/mesh/domain/transport.rho"
include "../src/mesh/domain/impact.rho"
include "../src/mesh/domain/deploy.rho"
include "../src/mesh/domain/manifest.rho"
include "../src/mesh/domain/production.rho"
include "../src/mesh/domain/access.rho"
include "../src/mesh/domain/poll.rho"
include "../src/mesh/domain/switch.rho"
include "../src/mesh/domain/alerting.rho"
include "../src/mesh/domain/signals.rho"

// Unit tests for Mesh's domain: the plan as text, the transport rule and the
// impact table. None of it reads a file, a registry or a board, which is what
// lets it be tested here rather than through the pages.

extern fn abort()
extern fn rho_hmac_sha256_hex(key_hex: string, message_hex: string) string

fn check(condition: bool, what: string) void {
    if !condition {
        print("FAIL: " + what + "\n")
        abort()
    }
}

/* -------------------------------------------------------------------------- */
/*  The plan as text                                                          */
/* -------------------------------------------------------------------------- */

// @verifies MESH-PLAN-0002
test fn a_parent_is_stored_by_number_and_read_by_row() void {
    let view: string = "node.count=2\nnode.1.name=Relay\nnode.1.parent=gateway\nnode.2.name=Leaf\nnode.2.parent=node.1\n"
    let stored: string = plan_stored(view)
    check(str_eq(plan_value(stored, "node.1.number"), "1"), "a node planned before numbers keeps its row number")
    check(str_eq(plan_value(stored, "node.2.number"), "2"), "the second keeps its row number too")
    check(str_eq(plan_value(stored, "node.2.parent_node"), "1"), "the parent is stored by its number")
    check(str_eq(plan_value(stored, "node.2.parent"), ""), "the row form is not stored")
    check(str_eq(plan_value(stored, "node.1.parent"), "gateway"), "the gateway is stored as it is")
    check(str_eq(plan_value(stored, "node.next_number"), "3"), "the counter is past every number")
    let back: string = plan_view(stored)
    check(str_eq(plan_value(back, "node.2.parent"), "node.1"), "the pages read the row form")
    print("[PASS] a_parent_is_stored_by_number_and_read_by_row\n")
}

// @verifies MESH-PLAN-0002
test fn a_parent_follows_its_number_when_rows_move() void {
    // Node 2 is number 7 and its child names it; after node 1 goes, it is row 1.
    let stored: string = "node.count=3\nnode.1.number=1\nnode.2.number=7\nnode.3.number=8\nnode.3.parent_node=7\nnode.next_number=9\n"
    let removed: string = plan_text_remove_node(plan_view(stored), 1)
    check(str_eq(plan_value(removed, "node.count"), "2"), "the count falls by one")
    check(str_eq(plan_value(removed, "node.1.number"), "7"), "the second node is the first row, with its number")
    check(str_eq(plan_value(removed, "node.2.parent"), "node.1"), "its child names its new row")
    check(str_eq(plan_value(plan_stored(removed), "node.2.parent_node"), "7"), "and stores the same number")
    print("[PASS] a_parent_follows_its_number_when_rows_move\n")
}

// @verifies MESH-PLAN-0002
test fn removing_a_node_sends_its_children_to_the_gateway() void {
    let view: string = "node.count=3\nnode.1.number=1\nnode.2.number=2\nnode.2.parent=node.1\nnode.3.number=3\nnode.3.parent=node.2\nstatus.node.2=built\nstatus.node.3=flashed\n"
    let removed: string = plan_text_remove_node(view, 2)
    check(str_eq(plan_value(removed, "node.2.number"), "3"), "the row after moves up with its number")
    check(str_eq(plan_value(removed, "node.2.parent"), "gateway"), "a child of the removed node goes to the gateway")
    check(str_eq(plan_value(removed, "status.node.2"), "flashed"), "a status moves with its row")
    check(str_eq(plan_value(removed, "node.3.number"), ""), "the last row is gone")
    print("[PASS] removing_a_node_sends_its_children_to_the_gateway\n")
}

// @verifies MESH-PLAN-0002
test fn a_new_node_never_takes_a_number_that_was_used() void {
    // Numbers 1 and 2 were given, node 2 was removed; the new row 2 gets 3.
    let view: string = "node.count=2\nnode.1.number=1\nnode.2.name=New\nnode.next_number=3\n"
    let stored: string = plan_stored(view)
    check(str_eq(plan_value(stored, "node.2.number"), "3"), "the next number never used")
    check(str_eq(plan_value(stored, "node.next_number"), "4"), "and the counter moves past it")
    print("[PASS] a_new_node_never_takes_a_number_that_was_used\n")
}

test fn a_key_is_replaced_not_repeated() void {
    let text: string = plan_without("a=1\nb=2\nab=3\n", "a") + "a=4\n"
    check(str_eq(plan_value(text, "a"), "4"), "the new value")
    check(str_eq(plan_value(text, "ab"), "3"), "a longer key with the same start is kept")
    print("[PASS] a_key_is_replaced_not_repeated\n")
}

/* -------------------------------------------------------------------------- */
/*  Transports                                                                */
/* -------------------------------------------------------------------------- */

// @verifies MESH-PLAN-0005
test fn a_transport_fits_what_both_boards_are() void {
    let pico: BoardCaps = BoardCaps{ "", false, true, false, "uart i2c spi" }
    let uno: BoardCaps = BoardCaps{ "", false, false, false, "uart i2c" }
    let host: BoardCaps = BoardCaps{ "", true, true, true, "" }
    check(transport_fits("wifi", pico, pico), "two wireless boards share wifi")
    check(!transport_fits("wifi", pico, uno), "a board without radio has no wifi")
    check(transport_fits("uart", pico, uno), "a bus both have")
    check(!transport_fits("spi", pico, uno), "a bus only one has")
    check(transport_fits("socket", host, pico), "a host and a wireless board share a socket")
    check(transport_fits("console", host, pico), "a host serves a console")
    check(!transport_fits("console", pico, uno), "a board that is not a host serves none")
    print("[PASS] a_transport_fits_what_both_boards_are\n")
}

// @verifies MESH-PLAN-0005
test fn declared_links_are_the_whole_answer() void {
    let gateway: BoardCaps = BoardCaps{ "uart console", true, true, false, "" }
    let relay: BoardCaps = BoardCaps{ "uart wifi", false, true, false, "" }
    check(transport_fits("uart", gateway, relay), "a link both declare")
    check(!transport_fits("wifi", gateway, relay), "a link one does not declare, whatever its radio")
    check(!transport_fits("console", gateway, relay), "a console the child does not declare")
    print("[PASS] declared_links_are_the_whole_answer\n")
}

/* -------------------------------------------------------------------------- */
/*  The impact table                                                          */
/* -------------------------------------------------------------------------- */

test fn a_build_depends_on_structure_not_on_names() void {
    check(impact_structural("board"), "a board is built for")
    check(impact_structural("parent"), "a parent is linked to")
    check(impact_structural("module"), "a module is compiled in")
    check(!impact_structural("name"), "a name is not")
    check(!impact_structural("description"), "nor a description")
    check(!impact_structural("address"), "nor a device's address")
    print("[PASS] a_build_depends_on_structure_not_on_names\n")
}

test fn reopening_a_stage_reopens_every_later_one() void {
    check(str_eq(impact_steps("topology"), "step_network step_build step_verify"), "after the topology")
    check(str_eq(impact_steps("network"), "step_build step_verify"), "after the network")
    check(str_eq(impact_steps("build"), "step_verify"), "after the build")
    check(str_eq(impact_steps("verify"), ""), "nothing after the last")
    check(impact_resets_builds("topology") && impact_resets_builds("network") && !impact_resets_builds("build"),
        "a new topology or network is built again")
    print("[PASS] reopening_a_stage_reopens_every_later_one\n")
}

/* -------------------------------------------------------------------------- */
/*  What a board was built from                                               */
/* -------------------------------------------------------------------------- */

// A gateway with a Pico on UART that carries a temperature module, and a plug.
const DEPLOY_PLAN: string = "gateway=native\nnode.count=3\n" +
    "node.1.kind=compute\nnode.1.number=1\nnode.1.name=Relay\nnode.1.board=pico2w\nnode.1.role=node\nnode.1.parent=gateway\nnode.1.link=uart\nnode.1.baud=115200\n" +
    "node.2.kind=module\nnode.2.number=2\nnode.2.module=ds18b20\nnode.2.parent=node.1\n" +
    "node.3.kind=device\nnode.3.number=3\nnode.3.device=shelly\nnode.3.address=192.0.2.5\nnode.3.parent=gateway\n"

const DEPLOY_WIFI_KEY: string = "5f0a1c2e3d4b6a798812a3b4c5d6e7f80112233445566778899aabbccddeeff0"

// The mesh the plan is built in: the fleet's area and uplink port, the scope of
// its gateway key, and no mesh above it.
const DEPLOY_MESH: string = "area=5\nuplink=28500\nkey=00112233aabbccdd\nwifikey=" + DEPLOY_WIFI_KEY + "\nabove=\n"

fn deploy_with(text: string, key: string, value: string) string {
    return plan_without(text, key) + key + "=" + value + "\n"
}

// @verifies MESH-BUILD-0001
test fn a_name_or_a_device_builds_nothing() void {
    let before: string = deploy_node_signature(DEPLOY_PLAN, 1, DEPLOY_MESH)
    let renamed: string = deploy_with(DEPLOY_PLAN, "node.1.name", "Greenhouse relay")
    check(str_eq(deploy_node_signature(renamed, 1, DEPLOY_MESH), before), "a new name is not in the image")
    let readdressed: string = deploy_with(DEPLOY_PLAN, "node.3.address", "192.0.2.9")
    check(str_eq(deploy_node_signature(readdressed, 1, DEPLOY_MESH), before), "a device's address is not either")
    check(str_eq(deploy_gateway_signature(readdressed, DEPLOY_MESH), deploy_gateway_signature(DEPLOY_PLAN, DEPLOY_MESH)),
        "nor is it in the gateway's")
    print("[PASS] a_name_or_a_device_builds_nothing\n")
}

// @verifies MESH-BUILD-0001, MESH-BUILD-0002
test fn a_module_or_a_board_rebuilds_that_board() void {
    let before: string = deploy_node_signature(DEPLOY_PLAN, 1, DEPLOY_MESH)
    let new_module: string = deploy_with(DEPLOY_PLAN, "node.2.module", "bme280")
    check(str_eq(deploy_reason(before, deploy_node_signature(new_module, 1, DEPLOY_MESH)), "modules changed"), "a new module")
    let board: string = deploy_with(DEPLOY_PLAN, "node.1.board", "lolin32-lite")
    check(str_eq(deploy_reason(before, deploy_node_signature(board, 1, DEPLOY_MESH)), "board changed"), "a new board")
    check(str_eq(deploy_gateway_signature(board, DEPLOY_MESH), deploy_gateway_signature(DEPLOY_PLAN, DEPLOY_MESH)),
        "the gateway does not care which board is on the other end")
    print("[PASS] a_module_or_a_board_rebuilds_that_board\n")
}

// @verifies MESH-BUILD-0002
test fn a_link_rebuilds_the_board_and_restarts_its_parent() void {
    let before: string = deploy_node_signature(DEPLOY_PLAN, 1, DEPLOY_MESH)
    let baud: string = deploy_with(DEPLOY_PLAN, "node.1.baud", "57600")
    check(str_eq(deploy_reason(before, deploy_node_signature(baud, 1, DEPLOY_MESH)), "link changed"), "the board's own link")
    check(str_eq(deploy_reason(deploy_gateway_signature(DEPLOY_PLAN, DEPLOY_MESH), deploy_gateway_signature(baud, DEPLOY_MESH)),
        "a link it serves changed"), "the gateway serving it restarts")
    print("[PASS] a_link_rebuilds_the_board_and_restarts_its_parent\n")
}

// @verifies MESH-BUILD-0001, MESH-BUILD-0002
test fn a_board_on_wifi_follows_the_gateway_address() void {
    let wifi: string = deploy_with(DEPLOY_PLAN, "node.1.link", "wifi")
    let before: string = deploy_node_signature(wifi, 1, DEPLOY_MESH)
    let moved: string = deploy_with(wifi, "gateway_host", "192.0.2.20")
    check(str_eq(deploy_reason(before, deploy_node_signature(moved, 1, DEPLOY_MESH)), "gateway address changed"),
        "a board that dials the gateway is rebuilt when it moves")
    let serial_moved: string = deploy_with(DEPLOY_PLAN, "gateway_host", "192.0.2.20")
    check(str_eq(deploy_node_signature(serial_moved, 1, DEPLOY_MESH), deploy_node_signature(DEPLOY_PLAN, 1, DEPLOY_MESH)),
        "a board on a serial line is not")
    print("[PASS] a_board_on_wifi_follows_the_gateway_address\n")
}

// @verifies MESH-BUILD-0002
test fn a_board_never_programmed_says_so() void {
    check(str_eq(deploy_reason("", deploy_node_signature(DEPLOY_PLAN, 1, DEPLOY_MESH)), "never programmed"), "nothing recorded")
    check(str_eq(deploy_reason(deploy_node_signature(DEPLOY_PLAN, 1, DEPLOY_MESH), deploy_node_signature(DEPLOY_PLAN, 1, DEPLOY_MESH)), ""),
        "what was programmed is what is planned")
    check(deploy_is_board(DEPLOY_PLAN, 1) && !deploy_is_board(DEPLOY_PLAN, 2) && !deploy_is_board(DEPLOY_PLAN, 3),
        "modules and devices have no image of their own")
    print("[PASS] a_board_never_programmed_says_so\n")
}

// @verifies MESH-BUILD-0002
test fn the_diff_names_what_changed_and_how() void {
    let before: string = deploy_node_signature(DEPLOY_PLAN, 1, DEPLOY_MESH)
    let after: string = deploy_node_signature(deploy_with(DEPLOY_PLAN, "node.1.board", "lolin32-lite"), 1, DEPLOY_MESH)
    let diff: string = deploy_diff(before, after)
    check(str_eq(diff, "board|pico2w|lolin32-lite\n"), "one segment, from what runs to what is planned")
    check(str_eq(deploy_diff(before, before), ""), "nothing differs, nothing listed")
    print("[PASS] the_diff_names_what_changed_and_how\n")
}

// A board flashed under one area carries it (CONFIG_RH_AREA_ID) and is admitted
// by its gateway at it: moving the mesh to another area puts every board and the
// gateway out of date, whether the area is the plan's own or the fleet's.
// @verifies MESH-0003, MESH-BUILD-0001, MESH-BUILD-0002
test fn a_board_flashed_in_another_area_is_out_of_date() void {
    let in_a: string = deploy_with(DEPLOY_PLAN, "area_id", "4")
    let in_b: string = deploy_with(DEPLOY_PLAN, "area_id", "7")
    check(str_eq(deploy_reason(deploy_node_signature(in_a, 1, DEPLOY_MESH), deploy_node_signature(in_b, 1, DEPLOY_MESH)),
        "area changed"), "a board flashed in area 4 is out of date in area 7")
    check(str_eq(deploy_reason(deploy_gateway_signature(in_a, DEPLOY_MESH), deploy_gateway_signature(in_b, DEPLOY_MESH)),
        "area changed"), "and so is the gateway, which is started with the area")
    let fleet_a: string = deploy_mesh("4", "28500", "00112233aabbccdd", DEPLOY_WIFI_KEY, "")
    let fleet_b: string = deploy_mesh("7", "28500", "00112233aabbccdd", DEPLOY_WIFI_KEY, "")
    check(str_eq(deploy_reason(deploy_node_signature(DEPLOY_PLAN, 1, fleet_a), deploy_node_signature(DEPLOY_PLAN, 1, fleet_b)),
        "area changed"), "a plan without its own area follows the fleet's")
    check(str_eq(deploy_node_signature(in_a, 1, fleet_a), deploy_node_signature(in_a, 1, fleet_b)),
        "and the plan's own area is the one a build reads")
    print("[PASS] a_board_flashed_in_another_area_is_out_of_date\n")
}

// A board's key is derived from the gateway key, and its image carries that key
// and the key's scope: another gateway key, whether made anew, imported or put
// back from elsewhere, puts every board and the gateway out of date.
// @verifies MESH-0003, MESH-BUILD-0001, MESH-BUILD-0002
test fn a_board_keyed_to_another_gateway_key_is_out_of_date() void {
    let old_key: string = deploy_mesh("5", "28500", "00112233aabbccdd", DEPLOY_WIFI_KEY, "")
    let new_key: string = deploy_mesh("5", "28500", "ffeeddccbbaa9988", DEPLOY_WIFI_KEY, "")
    check(str_eq(deploy_reason(deploy_node_signature(DEPLOY_PLAN, 1, old_key), deploy_node_signature(DEPLOY_PLAN, 1, new_key)),
        "gateway key changed"), "a board keyed to the old gateway key is out of date")
    check(str_eq(deploy_reason(deploy_gateway_signature(DEPLOY_PLAN, old_key), deploy_gateway_signature(DEPLOY_PLAN, new_key)),
        "gateway key changed"), "and so is the gateway, which is started with the key")
    let no_key: string = deploy_mesh("5", "28500", "", DEPLOY_WIFI_KEY, "")
    check(str_eq(deploy_reason(deploy_node_signature(DEPLOY_PLAN, 1, no_key), deploy_node_signature(DEPLOY_PLAN, 1, old_key)),
        "gateway key changed"), "a board built with a plain link is out of date once there is a key")
    check(str_index_of(deploy_node_signature(DEPLOY_PLAN, 1, old_key), "00112233aabbccdd") >= 0,
        "the key is named by its scope, never by itself")
    // A rotation is delivered to the board by REKEY, not by a build.
    check(str_eq(deploy_node_signature(deploy_with(DEPLOY_PLAN, "node.1.epoch", "1"), 1, DEPLOY_MESH),
        deploy_node_signature(DEPLOY_PLAN, 1, DEPLOY_MESH)), "a board's key epoch is not in its signature")
    print("[PASS] a_board_keyed_to_another_gateway_key_is_out_of_date\n")
}

// What else a build reads from outside the board's own row: its number, the
// mesh's Wi-Fi a board without its own takes, the uplink port the fleet gave a
// plan without one, and, for a gateway that reports through another mesh, that
// mesh's address and key.
// @verifies MESH-BUILD-0001, MESH-BUILD-0002
test fn what_a_build_falls_back_to_is_in_the_signature() void {
    let before: string = deploy_node_signature(DEPLOY_PLAN, 1, DEPLOY_MESH)
    check(str_eq(deploy_reason(before, deploy_node_signature(deploy_with(DEPLOY_PLAN, "node.1.number", "8"), 1, DEPLOY_MESH)),
        "node number changed"), "the board's number is in its image")
    let wifi: string = deploy_with(deploy_with(DEPLOY_PLAN, "node.1.link", "wifi"), "ssid", "Greenhouse")
    let wifi_before: string = deploy_node_signature(wifi, 1, DEPLOY_MESH)
    check(str_eq(deploy_reason(wifi_before, deploy_node_signature(deploy_with(wifi, "ssid", "Orchard"), 1, DEPLOY_MESH)),
        "link changed"), "a board without its own Wi-Fi takes the mesh's")
    check(str_eq(deploy_reason(wifi_before, deploy_node_signature(deploy_with(wifi, "password", "another-secret"), 1, DEPLOY_MESH)),
        "link changed"), "and its password")
    check(str_eq(deploy_node_signature(deploy_with(wifi, "node.1.ssid", "Own"), 1, DEPLOY_MESH),
        deploy_node_signature(deploy_with(deploy_with(wifi, "node.1.ssid", "Own"), "ssid", "Orchard"), 1, DEPLOY_MESH)),
        "a board with its own Wi-Fi does not")
    let other_port: string = deploy_mesh("5", "28501", "00112233aabbccdd", DEPLOY_WIFI_KEY, "")
    check(str_eq(deploy_reason(wifi_before, deploy_node_signature(wifi, 1, other_port)), "gateway address changed"),
        "a board that dials the gateway follows the fleet's uplink port")
    check(str_eq(deploy_reason(deploy_gateway_signature(DEPLOY_PLAN, DEPLOY_MESH), deploy_gateway_signature(DEPLOY_PLAN, other_port)),
        "its uplink port changed"), "and so does the gateway")
    let own_port: string = deploy_with(wifi, "uplink_port", "29000")
    check(str_eq(deploy_node_signature(own_port, 1, DEPLOY_MESH), deploy_node_signature(own_port, 1, other_port)),
        "a plan's own uplink port is the one a build reads")
    let relay_a: string = deploy_mesh("5", "28500", "00112233aabbccdd", DEPLOY_WIFI_KEY, "192.0.2.1:28400/aaaaaaaaaaaaaaaa")
    let relay_b: string = deploy_mesh("5", "28500", "00112233aabbccdd", DEPLOY_WIFI_KEY, "192.0.2.1:28400/bbbbbbbbbbbbbbbb")
    let relayed: string = deploy_with(DEPLOY_PLAN, "mesh_parent", "farm")
    check(str_eq(deploy_reason(deploy_gateway_signature(relayed, relay_a), deploy_gateway_signature(relayed, relay_b)),
        "the mesh it reports through changed"), "a relay gateway follows the key of the mesh above")
    check(str_eq(deploy_node_signature(DEPLOY_PLAN, 1, relay_a), deploy_node_signature(DEPLOY_PLAN, 1, relay_b)),
        "which its boards do not carry")
    print("[PASS] what_a_build_falls_back_to_is_in_the_signature\n")
}

// A record written before the signature named the area and the key (Mesh 0.21.0
// and earlier) cannot say what the board was built with: it is out of date, and
// says so, rather than compared segment by segment.
// @verifies MESH-BUILD-0002, MESH-BUILD-0012
test fn a_record_without_the_area_and_key_is_not_trusted() void {
    let old_board: string = "board=pico2w;role=node;parent=gateway;link=uart,baud:115200;modules=ds18b20@2,;serves="
    let old_gateway: string = "runs=native;host=;rest=;uplink=;serves=1:uart,baud:115200/;above=;below="
    check(str_eq(deploy_reason(old_board, deploy_node_signature(DEPLOY_PLAN, 1, DEPLOY_MESH)), DEPLOY_UNKNOWN),
        "a board recorded by 0.21.0 is out of date for that reason alone")
    check(str_eq(deploy_reason(old_gateway, deploy_gateway_signature(DEPLOY_PLAN, DEPLOY_MESH)), DEPLOY_UNKNOWN),
        "and so is a gateway")
    check(str_eq(DEPLOY_UNKNOWN, "recorded without its area and key"), "the reason says what is missing")
    check(str_eq(deploy_reason(DEPLOY_SHAPE_UNKNOWN, deploy_node_signature(DEPLOY_PLAN, 1, DEPLOY_MESH)), DEPLOY_UNKNOWN),
        "and so is the record such a record is replaced with when it is read")
    check(str_eq(deploy_reason("", deploy_node_signature(DEPLOY_PLAN, 1, DEPLOY_MESH)), "never programmed"),
        "nothing recorded is still never programmed")
    print("[PASS] a_record_without_the_area_and_key_is_not_trusted\n")
}

// A signature is written to deployed.txt, shown in the apply page's diff and
// carried in a job's record: a Wi-Fi password is in it only as a keyed digest
// that changes with the password, the board's own or the mesh's it inherits.
// @verifies MESH-BUILD-0013, MESH-BUILD-0001, MESH-BUILD-0002
test fn a_signature_never_holds_a_wifi_password() void {
    let wifi: string = deploy_with(deploy_with(deploy_with(DEPLOY_PLAN, "node.1.link", "wifi"), "ssid", "Greenhouse"),
        "password", "mesh-secret-9")
    let own: string = deploy_with(wifi, "node.1.password", "own-secret-7")
    let inherited_sig: string = deploy_node_signature(wifi, 1, DEPLOY_MESH)
    let own_sig: string = deploy_node_signature(own, 1, DEPLOY_MESH)
    check(str_index_of(inherited_sig, "mesh-secret-9") < 0, "the mesh's password is not in a board's signature")
    check(str_index_of(own_sig, "own-secret-7") < 0, "nor is a board's own")
    check(str_index_of(deploy_gateway_signature(own, DEPLOY_MESH), "own-secret-7") < 0 &&
        str_index_of(deploy_gateway_signature(wifi, DEPLOY_MESH), "mesh-secret-9") < 0, "nor in the gateway's, which serves the link")
    check(str_index_of(deploy_diff("", own_sig), "own-secret-7") < 0, "nor in a diff a page shows")
    check(str_eq(deploy_reason(own_sig, deploy_node_signature(deploy_with(own, "node.1.password", "own-secret-8"), 1, DEPLOY_MESH)),
        "link changed"), "a new password of its own still puts the board out of date")
    check(str_eq(deploy_reason(inherited_sig, deploy_node_signature(deploy_with(wifi, "password", "mesh-secret-10"), 1, DEPLOY_MESH)),
        "link changed"), "and so does a new password it inherits")
    let other_mesh: string = deploy_mesh("5", "28500", "00112233aabbccdd", "aa" + str_slice(DEPLOY_WIFI_KEY, 2, 62), "")
    check(!str_eq(own_sig, deploy_node_signature(own, 1, other_mesh)), "the same password digests differently in another mesh")
    check(str_eq(deploy_wifi_digest(DEPLOY_MESH, "Greenhouse", "own-secret-7"),
        str_slice(rho_hmac_sha256_hex(DEPLOY_WIFI_KEY, deploy_text_hex("rh-wifi-sig1|Greenhouse|own-secret-7")), 0, 16)) &&
        strlen(deploy_wifi_digest(DEPLOY_MESH, "Greenhouse", "own-secret-7")) == 16, "the digest is the keyed HMAC, 16 hex digits")
    check(str_eq(deploy_text_hex("rh|"), "72687c"), "taken over the text's bytes")
    print("[PASS] a_signature_never_holds_a_wifi_password\n")
}

/* -------------------------------------------------------------------------- */
/*  The node manifest                                                         */
/* -------------------------------------------------------------------------- */

const MANIFEST_PLAN: string = "node.count=5\n" +
    "node.1.id=0123456789abcdef\nnode.1.number=4\nnode.1.role=relay\nnode.1.kind=compute\n" +
    "node.2.id=1111222233334444\nnode.2.number=9\nnode.2.role=node\nnode.2.revoked=1\n" +
    "node.3.id=aaaabbbbccccdddd\nnode.3.kind=module\nnode.3.role=module\n" +
    "node.4.id=5555666677778888\nnode.4.kind=device\n" +
    "node.5.number=12\nnode.5.role=node\n"

// @verifies MESH-ACCESS-0003
test fn the_manifest_lists_every_board_with_its_placement() void {
    let lines: string = manifest_nodes(MANIFEST_PLAN, "3")
    check(str_eq(manifest_find(lines, "0123456789abcdef"), "0123456789abcdef|3|4|relay|0|0|"),
        "a relay is listed with its area, number and role, announcing nothing")
    check(str_eq(manifest_find(lines, "1111222233334444"), "1111222233334444|3|9|board|0|1|"),
        "a revoked board is listed as revoked")
    check(str_eq(manifest_find(lines, "aaaabbbbccccdddd"), ""), "a module opens no session and is not listed")
    check(str_eq(manifest_find(lines, "5555666677778888"), ""), "a device is not listed")
    check(str_index_of(lines, "|12|") < 0, "a board without an id has no key and no line")
    let document: string = manifest_document(lines, manifest_relay_line("9999aaaabbbbcccc", "07", "7,8"))
    check(str_index_of(document, "#") == 0, "the file starts with what it is")
    check(str_eq(manifest_find(document, "9999aaaabbbbcccc"), "9999aaaabbbbcccc|7|0|relay|0|0|7,8"),
        "a mesh linked below is a relay for its areas")
    check(str_eq(manifest_relay_line("not-an-id", "7", "7"), ""), "a relay without an id has no line")
    check(str_eq(manifest_areas_add(manifest_areas_add("7", "8"), "7"), "7,8"), "an area is listed once")
    check(!manifest_uid_ok("0123456789ABCDEF"), "an id is lowercase hex")
    print("[PASS] the_manifest_lists_every_board_with_its_placement\n")
}

// @verifies MESH-ACCESS-0002, MESH-ACCESS-0003
test fn a_rotated_board_is_listed_at_its_key_epoch() void {
    let plan: string = MANIFEST_PLAN + "node.1.epoch=3\nnode.5.epoch=junk\n"
    let lines: string = manifest_nodes(plan, "3")
    check(str_eq(manifest_find(lines, "0123456789abcdef"), "0123456789abcdef|3|4|relay|3|0|"),
        "a rotated node is listed at its epoch")
    check(manifest_node_epoch(plan, 2) == 0, "a node never rotated is at epoch 0")
    check(manifest_node_epoch(plan, 5) == 0, "an epoch that is not a number is 0")
    check(str_eq(manifest_key_message("0123456789abcdef", 0), "72682d646576310123456789abcdef"),
        "epoch 0 derives as rh-dev1 | uid")
    check(str_eq(manifest_key_message("0123456789abcdef", 258), "72682d646576320123456789abcdef02010000"),
        "a later epoch derives as rh-dev2 | uid | epoch, little-endian")
    print("[PASS] a_rotated_board_is_listed_at_its_key_epoch\n")
}

// @verifies MESH-ACCESS-0005
test fn a_rotation_waits_for_the_board_to_confirm() void {
    let report: string = "# uid|epoch|status|time\n0123456789abcdef|2|confirmed|100\n1111222233334444|1|cannot|200\n"
    check(str_eq(rekey_state(report, "aaaabbbbccccdddd", 0), ""), "a board never rotated has no state")
    check(str_eq(rekey_state(report, "aaaabbbbccccdddd", 1), "waiting"), "a rotated board the gateway has not heard is waiting")
    check(str_eq(rekey_state(report, "0123456789abcdef", 2), "confirmed"), "a board that confirmed its epoch is rotated")
    check(str_eq(rekey_state(report, "0123456789abcdef", 3), "waiting"), "and waits again once rotated further")
    check(str_eq(rekey_state(report, "1111222233334444", 1), "cannot"), "a board with no store cannot rotate")
    check(str_eq(rotate_refusal(report, "0123456789abcdef", 2), ""), "a confirmed board may be rotated again")
    check(str_eq(rotate_refusal(report, "0123456789abcdef", 3), "unconfirmed"), "an unconfirmed one may not")
    check(str_eq(rotate_refusal(report, "1111222233334444", 1), "cannot"), "nor one that cannot rotate")
    check(str_eq(rotate_refusal("", "aaaabbbbccccdddd", 0), ""), "a board at epoch 0 may be rotated")
    let api: string = "[{\"uid\":\"0123456789abcdef\",\"manifest_epoch\":2,\"confirmed\":2,\"epoch\":2,\"status\":\"confirmed\",\"time\":100}," +
        "{\"uid\":\"1111222233334444\",\"manifest_epoch\":1,\"confirmed\":-1,\"epoch\":1,\"status\":\"cannot\",\"time\":200}]"
    check(str_eq(rekey_from_json(api), "0123456789abcdef|2|confirmed|100\n1111222233334444|1|cannot|200\n"),
        "a remote gateway's keys read as rekey.txt lines")
    print("[PASS] a_rotation_waits_for_the_board_to_confirm\n")
}

/* -------------------------------------------------------------------------- */
/*  Production builds                                                         */
/* -------------------------------------------------------------------------- */

// @verifies MESH-BUILD-0009
test fn the_production_toggle_shows_for_a_platform_with_a_plan() void {
    // The folders the platforms ship, as `ls <platform>/production` lists them.
    let esp32: string = "esp32.json\npartitions.production.csv\nproduction.conf\nsdkconfig.production\n"
    let pico: string = "production.conf\nrp2350.json\n"
    let stm32: string = "production.conf\nproduction.json\n"
    check(str_eq(production_candidates("Pico2W", "rp2350", ""), "pico2w.json\nrp2350.json\nproduction.json\n"),
        "a plan is looked up by target, preset, family and platform, in lowercase")
    check(str_eq(production_candidates("x", "x", "../y"), "x.json\nproduction.json\n"),
        "a repeated name or one with a path is skipped")
    check(production_available(esp32, "lolin32-lite", "esp32", ""), "an ESP32 board has a production mode, by its preset")
    check(production_available(pico, "pico2w", "rp2350", ""), "an RP2350 board has one, by its preset")
    check(!production_available(pico, "pico", "rp2040", ""), "an RP2040 board of the same platform has none")
    check(str_eq(production_plan_name(stm32, "nucleo-h753zi", "stm32h7", "STM32H7"), "production.json"),
        "an STM32 board has the platform's plan")
    check(!production_available("", "uno-r3", "atmega328p", ""), "an AVR board has no production folder, so no mode")
    check(!production_available("", "arduino-uno-q", "uno-q", "host"), "nor has a Linux host")
    check(!production_available("production.conf\n", "x", "y", ""), "a fragment alone is not a plan")
    let spec: string = "{\n  \"kind\": \"board\",\n  \"name\": \"pico2w\",\n  \"preset\" : \"rp2350\",\n  \"family\": \"STM32F4\"\n}"
    check(str_eq(production_json_string(spec, "preset"), "rp2350"), "a target spec's preset is read")
    check(str_eq(production_json_string(spec, "family"), "STM32F4"), "and its family")
    check(str_eq(production_json_string(spec, "mcu"), ""), "a field it does not have is empty")
    check(str_eq(production_platform_root("/w/robohub-pico/boards/pico2w/module.yml"), "/w/robohub-pico"),
        "a board's platform is the folder above boards/")
    check(str_eq(production_platform_root("module.yml"), ""), "a manifest outside boards/ has none")
    print("[PASS] the_production_toggle_shows_for_a_platform_with_a_plan\n")
}

// @verifies MESH-BUILD-0010
test fn a_production_build_needs_the_key_its_plan_names() void {
    let esp32: string = "{\"build\": \"CONFIG_RH_PRODUCTION=y ..., RH_SECURE_BOOT_SIGNING_KEY naming the RSA-3072 PEM key.\"}"
    let pico: string = "{\"build\": \"RH_SECURE_BOOT_SIGNING_KEY ...\", \"steps\": [{\"command\": \"picotool otp load {env:RH_PICO_OTP_JSON}\"}]}"
    let stm32: string = "{\"build\": \"Any build\", \"steps\": [{\"command\": \"STM32_Programmer_CLI -ob RDP=0xBB\"}]}"
    check(production_needs_key(esp32) && !production_needs_otp(esp32), "an ESP32 plan needs the key and no OTP file")
    check(production_needs_key(pico) && production_needs_otp(pico), "an RP2350 plan needs both")
    check(!production_needs_key(stm32) && !production_needs_otp(stm32), "an STM32 plan needs neither")
    check(production_key_mode_ok("600") && production_key_mode_ok("400") && production_key_mode_ok("0600"), "an owner-only key is fine")
    check(!production_key_mode_ok("640") && !production_key_mode_ok("644") && !production_key_mode_ok("604") && !production_key_mode_ok(""),
        "a key the group or others can read is not")
    check(str_eq(production_key_refusal(true, "", false, ""), "missing"), "a production build is refused without a key")
    check(str_eq(production_key_refusal(true, "/k/esp.pem", false, ""), "missing"), "or with a key file that is not there")
    check(str_eq(production_key_refusal(true, "k/esp.pem", true, "600"), "relative"), "or one named by a relative path")
    check(str_eq(production_key_refusal(true, "/k/esp.pem", true, "644"), "open"), "or one others can read")
    check(str_eq(production_key_refusal(true, "/k/esp.pem", true, "600"), ""), "and queued with one in place")
    check(str_eq(production_key_refusal(false, "", false, ""), ""), "a plan that needs no key queues without one")
    print("[PASS] a_production_build_needs_the_key_its_plan_names\n")
}

// @verifies MESH-BUILD-0001, MESH-BUILD-0006, MESH-BUILD-0010, MESH-BUILD-0011
test fn the_production_job_scripts() void {
    let dir: string = "/m/p/boards/node_3"
    let bin: string = dir + "/build/output/node_3.elf"
    let plain_build: string = production_build_script("pico2w", dir, bin, "node_3", false, "/k/key.pem", true, dir + "/plan.txt")
    check(str_eq(plain_build, "cd '/m/p/boards/node_3'\nrho build -target 'pico2w' .\n"),
        "a plain build is the build as it was, with no key and no plan")
    check(str_eq(production_flash_script("pico2w", dir, bin, "node_3", false, true),
        "rho flash -target 'pico2w' -project '/m/p/boards/node_3' '/m/p/boards/node_3/build/output/node_3.elf'\n"),
        "a plain flash is the flash as it was")
    let build: string = production_build_script("pico2w", dir, bin, "node_3", true, "/k/key.pem", true, dir + "/plan.txt")
    check(str_index_of(build, "export RH_SECURE_BOOT_SIGNING_KEY='/k/key.pem'\nrho build -target 'pico2w' .\n") >= 0,
        "a production build is given the key by its path before it builds")
    check(str_index_of(build, "export RH_PICO_OTP_JSON='/m/p/boards/node_3/build/output/node_3.otp.json'\n") >= 0,
        "an RP2350 build points the flash at the OTP file it wrote")
    check(str_index_of(build, "'/m/p/boards/node_3/build/output/node_3.elf' --production --dry-run > '/m/p/boards/node_3/plan.txt'\n") >= 0,
        "and ends by writing what the flash will do")
    let esp: string = production_build_script("lolin32-lite", dir, bin, "node_3", true, "/k/rsa.pem", false, dir + "/plan.txt")
    check(str_index_of(esp, "RH_PICO_OTP_JSON") < 0 && str_index_of(esp, "RH_SECURE_BOOT_SIGNING_KEY='/k/rsa.pem'") >= 0,
        "an ESP32 build has the key and no OTP file")
    let stm: string = production_build_script("nucleo-h753zi", dir, bin, "node_3", true, "", false, dir + "/plan.txt")
    check(str_index_of(stm, "RH_SECURE_BOOT_SIGNING_KEY") < 0 && str_index_of(stm, "--dry-run") >= 0,
        "an STM32 build has no key but still prints its plan")
    let flash: string = production_flash_script("pico2w", dir, bin, "node_3", true, true)
    check(str_index_of(flash, "if [ ! -s \"$confirm\" ]; then echo 'no board name was typed: nothing was run'; exit 1; fi\n") >= 0,
        "a production flash stops when no name was typed")
    check(str_index_of(flash, "export RH_PICO_OTP_JSON='/m/p/boards/node_3/build/output/node_3.otp.json'\n") >= 0,
        "an RP2350 flash names its OTP file")
    check(str_index_of(flash, "'/m/p/boards/node_3/build/output/node_3.elf' --production < \"$confirm\"\n") >= 0,
        "and runs rho flash --production with the typed name on its input")
    check(str_index_of(flash, "--dry-run") < 0, "the flash itself is not a dry run")
    check(str_index_of(production_flash_script("lolin32-lite", dir, bin, "node_3", true, false), "RH_PICO_OTP_JSON") < 0,
        "an ESP32 flash has no OTP file")
    check(str_eq(production_quote("it's"), "'it'\\''s'"), "a quote in a value stays one word")
    // The toggle is part of what a board is built from.
    let plan: string = "node.count=1\nnode.1.kind=compute\nnode.1.board=pico2w\nnode.1.parent=gateway\n"
    let plain: string = deploy_node_signature(plan, 1, DEPLOY_MESH)
    check(str_index_of(plain, "production") < 0, "a board built plainly says nothing of production")
    check(str_eq(deploy_node_signature(plan + "node.1.production=off\n", 1, DEPLOY_MESH), plain), "and one turned off is the same")
    let hardened: string = deploy_node_signature(plan + "node.1.production=on\n", 1, DEPLOY_MESH)
    check(str_eq(deploy_reason(plain, hardened), "production build changed"), "turning it on makes the board out of date")
    print("[PASS] the_production_job_scripts\n")
}

// @verifies MESH-ACCESS-0007
test fn a_node_credential_is_read_from_its_header() void {
    let header: string = "Node gateway-node-01:00ff00ff00ff"
    check(str_eq(node_auth_part(header, 0), "gateway-node-01"), "the device")
    check(str_eq(node_auth_part(header, 1), "00ff00ff00ff"), "the credential")
    check(str_eq(node_auth_part("Bearer abc", 0), ""), "another scheme is not a node credential")
    check(str_eq(node_auth_part("Node :00ff", 0), ""), "a credential without a device")
    check(str_eq(node_auth_part("Node dev:", 1), ""), "a device without a credential")
    check(str_eq(node_auth_part("Node dev&x=1:00ff", 0), ""), "a device that would add a form field")
    check(str_eq(node_auth_part("Node dev:00ff&credential=1", 1), ""), "a credential that would add a form field")
    print("[PASS] a_node_credential_is_read_from_its_header\n")
}

// @verifies MESH-ACCESS-0008
test fn a_node_key_client_has_a_budget() void {
    check(str_eq(nodekey_client(""), "direct"), "a request to Mesh's own port")
    check(str_eq(nodekey_client("203.0.113.9, 192.168.1.20"), "192.168.1.20"), "the keeper proxy's entry")
    check(str_eq(nodekey_slot("192.168.1.20"), nodekey_slot("192.168.1.20")), "one client, one counter")
    var state: string = ""
    var i: u32 = 0
    while i < 10 {
        state = nodekey_count(state, 500, 60)
        i = i + 1
    }
    check(!nodekey_over(state, 10), "ten calls are within the budget")
    check(nodekey_over(nodekey_count(state, 530, 60), 10), "the eleventh is not")
    check(str_eq(nodekey_count(state, 560, 60), "1|560"), "a new window starts again")
    print("[PASS] a_node_key_client_has_a_budget\n")
}

/* -------------------------------------------------------------------------- */
/*  Access                                                                    */
/* -------------------------------------------------------------------------- */

// A request the middleware did not authenticate carries no audience: whatever
// scopes it claims, Mesh's own checks refuse it on every class of route — a
// mesh's pages and changes, Mesh as a whole, the fleet, the token page and the
// API — as if the middleware had been bypassed.
// @verifies MESH-API-0006, MESH-API-0001, MESH-API-0002
test fn a_request_nobody_authenticated_is_refused_everywhere() void {
    check(!mesh_grant("", "", "Sec", false, false), "reading a mesh with nothing")
    check(!mesh_grant("", "", "Sec", true, false), "changing a mesh with nothing")
    check(!mesh_grant("", "", "", false, false), "reading Mesh as a whole with nothing")
    check(!mesh_grant("", "", "", true, false), "changing Mesh as a whole with nothing")
    check(!mesh_grant("", "*", "Sec", true, false), "scopes without an audience are nobody's")
    check(!mesh_grant("", "mesh:*", "", true, false), "mesh:* without an audience is nobody's")
    check(!mesh_grant_every_mesh("", ""), "the whole fleet with nothing")
    check(!mesh_grant_every_mesh("", "*"), "the whole fleet without an audience")
    check(!mesh_grant_admin("", ""), "the token page with nothing")
    check(!mesh_grant_admin("", "*"), "the token page without an audience")
    check(!mesh_api_grant("", "", "Sec", false), "the API with nothing")
    check(!mesh_api_grant("", "*", "Sec", false), "the API without an audience")
    check(!mesh_grant("mesh", "", "Sec", false, false), "an authenticated request with no scopes has no grant")
    print("[PASS] a_request_nobody_authenticated_is_refused_everywhere\n")
}

// @verifies MESH-API-0001
test fn grants_decide_reading_and_changing_a_mesh() void {
    check(mesh_grant("mesh", "*", "Sec", true, false), "* changes a mesh")
    check(mesh_grant("mesh", "mesh:*", "", true, false), "mesh:* changes Mesh as a whole")
    check(mesh_grant("mesh", "mesh:Sec", "Sec", true, false), "mesh:Sec changes Sec")
    check(!mesh_grant("mesh", "mesh:Sec", "Other", false, false), "mesh:Sec does not read Other")
    check(!mesh_grant("mesh", "mesh:Sec", "", true, false), "mesh:Sec does not change Mesh as a whole")
    check(mesh_grant("mesh", "mesh:Sec", "", false, false), "mesh:Sec reads Mesh's overview")
    check(mesh_grant("mesh", "mesh:Sec:read", "Sec", false, false), "mesh:Sec:read reads Sec")
    check(!mesh_grant("mesh", "mesh:Sec:read", "Sec", true, false), "mesh:Sec:read does not change it")
    check(mesh_grant("mesh", "mesh:read", "Other", false, false), "mesh:read reads every mesh")
    check(!mesh_grant("mesh", "mesh:read", "Other", true, false), "mesh:read changes none")
    check(!mesh_grant("mesh", "*", "Sec", false, true), "a revoked subject may do nothing in that mesh")
    check(!mesh_grant("mesh", "mesh:Secret", "Sec", false, false), "a scope is matched whole, not by prefix")
    check(!mesh_grant("mesh", "robohub-mesh:x", "", false, false), "a scope that only contains mesh: is not a mesh grant")
    check(mesh_grant("mesh", "energy:read, mesh:Sec", "Sec", true, false), "a scope among others counts")
    check(mesh_grant_every_mesh("mesh", "mesh:read") && !mesh_grant_every_mesh("mesh", "mesh:Sec"),
        "only a grant over every mesh sees the whole fleet")
    check(mesh_grant_admin("mesh", "mesh:*") && !mesh_grant_admin("mesh", "mesh:Sec"),
        "only mesh:* or * holds Mesh as a whole")
    print("[PASS] grants_decide_reading_and_changing_a_mesh\n")
}

// A token for /mesh/api names the mesh it reads: one for another mesh, a
// read-only grant, or one with no mesh scope at all is refused.
// @verifies MESH-API-0002
test fn the_api_refuses_a_token_without_the_mesh_scope() void {
    check(mesh_api_grant("mesh", "mesh:Sec", "Sec", false), "mesh:Sec reads Sec through the API")
    check(mesh_api_grant("mesh", "mesh:*", "Sec", false), "mesh:* reads any mesh")
    check(mesh_api_grant("mesh", "*", "Sec", false), "* reads any mesh")
    check(!mesh_api_grant("mesh", "mesh:Other", "Sec", false), "a token for another mesh")
    check(!mesh_api_grant("mesh", "energy:read,aquarium:*", "Sec", false), "a token with no mesh scope")
    check(!mesh_api_grant("mesh", "mesh:Sec:read", "Sec", false), "a read grant is a person's, not a service token's")
    check(!mesh_api_grant("mesh", "mesh:Sec", "", false), "no mesh is no grant")
    check(!mesh_api_grant("mesh", "mesh:Sec", "Sec", true), "a revoked subject")
    print("[PASS] the_api_refuses_a_token_without_the_mesh_scope\n")
}

// Mesh asks for a gateway token for one mesh's gateway alone, and a token
// holding a gateway's scope opens none of Mesh's own routes.
// @verifies MESH-0011, MESH-API-0001, MESH-API-0002
test fn a_gateway_scope_is_for_its_own_gateway_only() void {
    check(str_eq(mesh_gateway_scope("Sec"), "gateway:Sec:*"), "Sec's gateway is asked with gateway:Sec:*")
    check(!str_eq(mesh_gateway_scope("Sec"), mesh_gateway_scope("Other")), "another mesh's gateway with another scope")
    check(str_eq(mesh_gateway_scope(""), "gateway:*"), "with no mesh, the scope Mesh may be issued")
    let held: string = mesh_gateway_scope("Sec")
    check(!mesh_grant("mesh", held, "Sec", false, false), "a gateway scope does not read the mesh in Mesh")
    check(!mesh_grant("mesh", held, "Sec", true, false), "nor change it")
    check(!mesh_grant("mesh", held, "", false, false), "nor read Mesh's overview")
    check(!mesh_grant_every_mesh("mesh", held) && !mesh_grant_admin("mesh", held), "nor the fleet or the tokens")
    check(!mesh_api_grant("mesh", held, "Sec", false), "nor Sec through the API")
    check(!mesh_api_grant("mesh", "gateway:*", "Other", false), "gateway:* opens no mesh's API")
    check(!mesh_grant("mesh", "gateway:mesh:*", "", false, false), "a gateway of a mesh named mesh is not a mesh: grant")
    print("[PASS] a_gateway_scope_is_for_its_own_gateway_only\n")
}

/* -------------------------------------------------------------------------- */
/*  Polling a gateway                                                         */
/* -------------------------------------------------------------------------- */

// @verifies MESH-TEL-0003
test fn a_gateway_that_does_not_answer_is_backed_off() void {
    var wait: u32 = 0
    var waits: string = ""
    var i: u32 = 0
    while i < 7 {
        wait = telemetry_backoff_next(wait, 60)
        waits = waits + int_to_str(i32(wait)) + " "
        i = i + 1
    }
    check(str_eq(waits, "2 4 8 16 32 60 60 "), "2 s, doubling, up to the maximum: " + waits)
    check(telemetry_backoff_next(0, 60) == 2, "a success starts over at 2 s")
    check(telemetry_backoff_next(8, 10) == 10, "the Storage tab's maximum is the ceiling")
    check(telemetry_backoff_next(3000000000, 60) == 60, "a wait never wraps around")
    check(telemetry_outage_fault_due(""), "the first failure of an outage is a fault")
    check(!telemetry_outage_fault_due("true"), "the next failures are not")
    print("[PASS] a_gateway_that_does_not_answer_is_backed_off\n")
}

/* -------------------------------------------------------------------------- */
/*  A switch, as the device reports it                                        */
/* -------------------------------------------------------------------------- */

// @verifies MESH-0022
test fn a_switch_is_shown_as_the_device_reports_it() void {
    check(str_eq(switch_outcome("", "on", true, 0, 30), "idle"), "nothing requested is idle")
    check(str_eq(switch_outcome("on", "", true, 0, 30), "pending"), "a command taken but not reported is pending")
    check(str_eq(switch_outcome("on", "on", true, 1, 30), "confirmed"), "the requested state reported is confirmed")
    check(str_eq(switch_outcome("on", "off", true, 5, 30), "pending"), "the other state reported does not end the wait early")
    check(str_eq(switch_outcome("on", "off", true, 30, 30), "unconfirmed"), "the wait over without the report is unconfirmed")
    check(str_eq(switch_outcome("on", "", true, 31, 30), "unconfirmed"), "and so is silence")
    check(str_eq(switch_outcome("off", "off", false, 0, 30), "unconfirmed"),
        "a device that cannot report its state is never confirmed, whatever was read")
    check(str_eq(switch_shown("pending", "off"), "pending"), "a pending switch is not shown as the requested state")
    check(str_eq(switch_shown("unconfirmed", "off"), "unconfirmed"), "nor an unconfirmed one")
    check(str_eq(switch_shown("confirmed", "on"), "on"), "a confirmed one is shown as reported")
    check(str_eq(switch_shown("idle", "off"), "off"), "with nothing waiting, the reported state")
    check(str_eq(switch_state_word("true"), "on") && str_eq(switch_state_word("1"), "on") &&
        str_eq(switch_state_word("false"), "off") && str_eq(switch_state_word("0"), "off"),
        "JSON booleans and the store's 1 and 0 are states")
    check(str_eq(switch_state_word(""), "") && str_eq(switch_state_word("banana"), ""),
        "anything else is not a report")
    print("[PASS] a_switch_is_shown_as_the_device_reports_it\n")
}

/* -------------------------------------------------------------------------- */
/*  Alerts                                                                    */
/* -------------------------------------------------------------------------- */

// @verifies MESH-0023
test fn an_alert_is_raised_once_per_cooldown() void {
    check(mesh_alert_due(0, 1000, 900), "an alert never raised is due")
    check(!mesh_alert_due(1000, 1000, 900), "the same alert at once is not")
    check(!mesh_alert_due(1000, 1899, 900), "nor within the cooldown")
    check(mesh_alert_due(1000, 1900, 900), "after the cooldown it is due again")
    check(mesh_alert_due(5000, 1000, 900), "a clock that went back does not silence it")
    check(str_eq(mesh_alert_key("Sec", "gateway"), "Sec-gateway"), "the key is the mesh and the subject")
    check(str_eq(mesh_alert_key("a/b", "job x"), "a_b-job_x"), "and is safe as a file name")
    print("[PASS] an_alert_is_raised_once_per_cooldown\n")
}

/* -------------------------------------------------------------------------- */
/*  Signals a part is given by its functions                                  */
/* -------------------------------------------------------------------------- */

// @verifies MESH-API-0009
test fn a_switch_function_is_an_output_signal() void {
    check(str_eq(signal_function_row("switch"), "switch|Switch|output||state|toggle button"),
        "a board that names the function switch gets a switch output, as a plug's switch is")
    check(str_eq(signal_function_row(" switch "), signal_function_row("switch")), "the name is read trimmed")
    check(str_eq(signal_function_row("temperature"), "temperature|Temperature|input|°C|temperature_c|numeric chart table"),
        "the inputs are as they were")
    check(str_eq(signal_function_row("teleport"), ""), "a function Mesh does not know gives no signal")
    check(str_eq(signal_device_rows("switch"), "switch|Switch|output||state|toggle button"),
        "a device of the kind switch gets the same output")
    check(str_eq(signal_device_rows("actuator"), signal_device_rows("switch")), "as an actuator does")
    print("[PASS] a_switch_function_is_an_output_signal\n")
}

fn main() void {
    a_parent_is_stored_by_number_and_read_by_row()
    a_parent_follows_its_number_when_rows_move()
    removing_a_node_sends_its_children_to_the_gateway()
    a_new_node_never_takes_a_number_that_was_used()
    a_key_is_replaced_not_repeated()
    a_transport_fits_what_both_boards_are()
    declared_links_are_the_whole_answer()
    a_build_depends_on_structure_not_on_names()
    reopening_a_stage_reopens_every_later_one()
    a_name_or_a_device_builds_nothing()
    a_module_or_a_board_rebuilds_that_board()
    a_link_rebuilds_the_board_and_restarts_its_parent()
    a_board_on_wifi_follows_the_gateway_address()
    a_board_never_programmed_says_so()
    the_diff_names_what_changed_and_how()
    a_board_flashed_in_another_area_is_out_of_date()
    a_board_keyed_to_another_gateway_key_is_out_of_date()
    what_a_build_falls_back_to_is_in_the_signature()
    a_record_without_the_area_and_key_is_not_trusted()
    a_signature_never_holds_a_wifi_password()
    the_manifest_lists_every_board_with_its_placement()
    a_rotated_board_is_listed_at_its_key_epoch()
    a_rotation_waits_for_the_board_to_confirm()
    the_production_toggle_shows_for_a_platform_with_a_plan()
    a_production_build_needs_the_key_its_plan_names()
    the_production_job_scripts()
    a_node_credential_is_read_from_its_header()
    a_node_key_client_has_a_budget()
    a_request_nobody_authenticated_is_refused_everywhere()
    grants_decide_reading_and_changing_a_mesh()
    the_api_refuses_a_token_without_the_mesh_scope()
    a_gateway_scope_is_for_its_own_gateway_only()
    a_gateway_that_does_not_answer_is_backed_off()
    a_switch_is_shown_as_the_device_reports_it()
    an_alert_is_raised_once_per_cooldown()
    a_switch_function_is_an_output_signal()
    print("mesh domain tests ok\n")
}
