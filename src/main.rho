// background is the telemetry worker: the generated server runs it on its own
// goroutine beside the HTTP listener. It polls every project's gateway and
// writes what it reads into the store the API serves.
fn init() void {
    log_config_apply("mesh")
    info("mesh", "starting")
}

fn background() void {
    telemetry_worker()
}
