// The shared modules Mesh uses, each through the interface its manifest exports.
import robohub.forms
import robohub.settings
import robohub.htmx
import robohub.i18n
import robohub.logging
import robohub.alert

// The orchestrator root. A hosted application is started with the workspace in
// the environment, and a standalone one from the repository root.
fn robohub_root() string {
    let root: string = getenv("ROBOHUB_ROOT")
    if root == "" {
        // ROBOHUB_WORKSPACE is the directory that holds the ecosystem's
        // repositories, the orchestrator among them.
        let workspace: string = getenv("ROBOHUB_WORKSPACE")
        if workspace != "" && rho_path_exists(workspace + "/robohub/registry/modules") {
            return workspace + "/robohub"
        }
        if rho_path_exists("registry/modules") {
            return "."
        }
        warn("mesh", "set ROBOHUB_ROOT to the orchestrator directory")
        return "."
    }
    if rho_path_exists(root + "/robohub/registry/modules") {
        return root + "/robohub"
    }
    if rho_path_exists(root + "/registry/modules") {
        return root
    }
    return root + "/robohub"
}

fn resolve_path(path: string) string {
    if rho_str_index_of(path, "/") == 0 {
        return path
    }
    return robohub_root() + "/" + path
}

