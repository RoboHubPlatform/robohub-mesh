//
// @file nodekey.rho
// @brief The board key a Linux host node fetches with its keeper credential.
//
// @module mesh.nodekey
// @project mesh
// @author Aurel Miron
// @date 2026-11-14
//
// SPDX-License-Identifier: MIT
