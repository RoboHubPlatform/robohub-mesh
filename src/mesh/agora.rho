module mesh.agora

// The agora is one screen per mesh: a bar that says whether the mesh is live,
// the tree of its gateway, nodes and devices — each card with its online state,
// when it was last seen and what it reads — an inspector for the node selected,
// and a strip with its faults and its steps. The fleet view is the level above:
// one card per mesh with its health, its readings and where its gateway runs,
// one inbox of faults across them, and the hosts they run on.
//
// Both are read-only: editing still happens on the plan's pages, linked from
// the inspector. Both are live: the background worker checks every mesh's
// gateway (agora_tick) and keeps the result beside the project, so drawing a
// page never waits on a gateway, and pushes a region to the page over one
// server-sent stream when what it shows has changed.

const AGORA_ONLINE_SECONDS: u32 = 60
const AGORA_HEALTH_FRESH_SECONDS: u32 = 20

/* -------------------------------------------------------------------------- */
/*  Gateway health, checked in the background                                 */
/* -------------------------------------------------------------------------- */

fn agora_health_file(id: string) string {
    return project_location(id) + "/health.txt"
}

// agora_project_ids are the projects with a plan, read without preparing the
// state folder (which the background worker must not do on every pass).
fn agora_project_ids() string {
    var out: string = ""
    var rest: string = project_listing()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var id: string = rest
        if at < 0 {
            rest = ""
        } else {
            id = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if id != "" && rho_path_exists(project_file(id)) {
            out = out + id + "\n"
        }
    }
    return out
}

// agora_gateway_kind is where a mesh's gateway runs: "native" on this machine,
// a board name, or "" when none is planned.
// A plan that names no gateway has it on this machine, as everywhere else in
// Mesh: its tree starts at "This host (native)".
fn agora_gateway_kind(id: string) string {
    let kind: string = state_value_in(project_file(id), "gateway")
    if kind == "" {
        return "native"
    }
    return kind
}

// agora_gateway_started is whether a mesh's gateway is one anything should
// expect to answer. A native gateway runs only when Mesh started it, which the
// process id beside the project says; a board's runs on the board.
fn agora_gateway_started(id: string) bool {
    if agora_gateway_kind(id) != "native" {
        return true
    }
    return rho_path_exists(fleet_pid_file(id))
}

fn agora_gateway_host(id: string) string {
    let host: string = state_value_in(project_file(id), "gateway_host")
    if host == "" || agora_gateway_kind(id) == "native" {
        return "127.0.0.1"
    }
    return host
}

fn agora_gateway_port(id: string) string {
    let rest: string = state_value_in(project_file(id), "rest_port")
    if rest == "" {
        return fleet_rest_port(id)
    }
    return rest
}

// agora_check_health asks a mesh's gateway whether it answers, and keeps the
// answer with the time the state began: "online|<since>|<checked>".
fn agora_check_health(id: string) void {
    let kind: string = agora_gateway_kind(id)
    var state: string = "none"
    if kind != "" {
        state = "offline"
        if gateway_reachable_for(kind, agora_gateway_host(id), agora_gateway_port(id)) {
            state = "online"
        } else if !agora_gateway_started(id) {
            state = "stopped"
        }
    }
    let now: u32 = mesh_now_seconds()
    let previous: string = rho_read_text(agora_health_file(id))
    var since: string = rho_int_to_str(now)
    if rho_str_eq(field(previous, 0), state) && field(previous, 1) != "" {
        since = field(previous, 1)
    }
    rho_write_text(agora_health_file(id), state + "|" + since + "|" + rho_int_to_str(now))
}

// agora_health is a mesh's gateway state as last checked: "online", "offline",
// "stopped" (a native gateway Mesh has not started), "none" (no gateway
// planned) or "unknown" (not checked yet).
fn agora_health(id: string) string {
    let state: string = field(rho_read_text(agora_health_file(id)), 0)
    if state == "" {
        return "unknown"
    }
    return state
}

fn agora_health_since(id: string) u32 {
    return u32(rho_int_from_str(field(rho_read_text(agora_health_file(id)), 1)))
}

// agora_gateway_online is whether a mesh's gateway answered when last checked,
// asked of it directly when nothing has checked it lately.
fn agora_gateway_online(id: string) bool {
    let record: string = rho_read_text(agora_health_file(id))
    let checked: u32 = u32(rho_int_from_str(field(record, 2)))
    let now: u32 = mesh_now_seconds()
    if checked > 0 && now >= checked && now - checked < AGORA_HEALTH_FRESH_SECONDS {
        return rho_str_eq(field(record, 0), "online")
    }
    agora_check_health(id)
    return agora_health(id) == "online"
}

/* -------------------------------------------------------------------------- */
/*  Readings                                                                  */
/* -------------------------------------------------------------------------- */

// agora_readings are a project's newest readings as source|field|value|seconds
// lines, from the telemetry store.
fn agora_readings(project: string) string {
    var out: string = ""
    var rest: string = telemetry_latest_events(project)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        // The reading is a JSON document inside the event's data, escaped.
        let data: string = agora_unescape(line)
        let source: string = agora_json_text(data, "source")
        let name: string = agora_json_text(data, "field")
        let value: string = agora_json_text(data, "value")
        let received: string = json_number(data, "received_ms")
        if source == "" || name == "" || json_number(data, "status") != "0" {
            continue
        }
        var seconds: u32 = 0
        if u32(rho_strlen(received)) > 3 {
            seconds = u32(rho_int_from_str(rho_str_slice(received, 0, u32(rho_strlen(received)) - 3)))
        }
        out = out + source + "|" + name + "|" + value + "|" + rho_int_to_str(seconds) + "\n"
    }
    return out
}

fn agora_unescape(text: string) string {
    var out: string = ""
    var rest: string = text
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\\\"")
        if at < 0 {
            out = out + rest
            rest = ""
        } else {
            out = out + rho_str_slice(rest, 0, u32(at)) + "\""
            rest = rho_str_slice(rest, u32(at) + 2, u32(rho_strlen(rest)) - u32(at) - 2)
        }
    }
    return out
}

// agora_json_text is a string field of a flat JSON document.
fn agora_json_text(text: string, key: string) string {
    let needle: string = "\"" + key + "\":\""
    let at: i32 = rho_str_index_of(text, needle)
    if at < 0 {
        return ""
    }
    let start: u32 = u32(at) + u32(rho_strlen(needle))
    let rest: string = rho_str_slice(text, start, u32(rho_strlen(text)) - start)
    let end: i32 = rho_str_index_of(rest, "\"")
    if end < 0 {
        return ""
    }
    return rho_str_slice(rest, 0, u32(end))
}

// agora_last_seen is when a source last reported, in seconds; 0 for never.
fn agora_last_seen(readings: string, source: string) u32 {
    var last: u32 = 0
    var rest: string = readings
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if source != "" && rho_str_eq(field(line, 0), source) {
            let seconds: u32 = u32(rho_int_from_str(field(line, 3)))
            if seconds > last {
                last = seconds
            }
        }
    }
    return last
}

// agora_newest is the time of a project's newest reading.
fn agora_newest(readings: string) u32 {
    var last: u32 = 0
    var rest: string = readings
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        let seconds: u32 = u32(rho_int_from_str(field(line, 3)))
        if seconds > last {
            last = seconds
        }
    }
    return last
}

// agora_chips are up to `limit` of a source's readings, as chips; every one
// when source is "" and limit is 0 is never asked for.
fn agora_chips(readings: string, source: string, limit: u32) string {
    var out: string = ""
    var count: u32 = 0
    var rest: string = readings
    while rest != "" && count < limit {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line != "" && (source == "" || rho_str_eq(field(line, 0), source)) {
            out = out + "<span class=\"agora-chip\"><span>" + escape_html(agora_field_label(field(line, 1))) +
                "</span> <strong>" + escape_html(agora_value(field(line, 1), field(line, 2))) + "</strong></span>"
            count = count + 1
        }
    }
    return out
}

// agora_value is a reading with its unit, which its field's name ends with.
fn agora_value(name: string, value: string) string {
    var shown: string = value
    let dot: i32 = rho_str_index_of(value, ".")
    if dot >= 0 && u32(rho_strlen(value)) > u32(dot) + 3 {
        shown = rho_str_slice(value, 0, u32(dot) + 3)
    }
    let unit: string = agora_unit(name)
    if unit == "" {
        return shown
    }
    return shown + " " + unit
}

fn agora_unit(name: string) string {
    if agora_ends(name, "_c") { return "°C" }
    if agora_ends(name, "_pct") || agora_ends(name, "_rh") { return "%" }
    if agora_ends(name, "_w") { return "W" }
    if agora_ends(name, "_v") { return "V" }
    if agora_ends(name, "_a") { return "A" }
    if agora_ends(name, "_hpa") { return "hPa" }
    if agora_ends(name, "_lux") { return "lx" }
    return ""
}

// agora_field_label is a field's name without its unit and its underscores.
fn agora_field_label(name: string) string {
    var label: string = name
    let units: string = "_c _pct _rh _w _v _a _hpa _lux"
    var rest: string = units
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, " ")
        var suffix: string = rest
        if at < 0 {
            rest = ""
        } else {
            suffix = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if agora_ends(label, suffix) {
            label = rho_str_slice(label, 0, u32(rho_strlen(label)) - u32(rho_strlen(suffix)))
            rest = ""
        }
    }
    var out: string = ""
    var i: u32 = 0
    while i < u32(rho_strlen(label)) {
        let ch: string = rho_str_slice(label, i, 1)
        if rho_str_eq(ch, "_") {
            out = out + " "
        } else {
            out = out + ch
        }
        i = i + 1
    }
    return out
}

fn agora_ends(text: string, suffix: string) bool {
    let length: u32 = u32(rho_strlen(text))
    let tail: u32 = u32(rho_strlen(suffix))
    return length > tail && rho_str_eq(rho_str_slice(text, length - tail, tail), suffix)
}

// agora_age is how long ago a moment was, the way a person says it.
fn agora_age(then: u32) string {
    let now: u32 = mesh_now_seconds()
    if then == 0 {
        return "never"
    }
    if then >= now {
        return "just now"
    }
    let seconds: u32 = now - then
    if seconds < 60 {
        return rho_int_to_str(seconds) + " s ago"
    }
    if seconds < 3600 {
        return rho_int_to_str(seconds / 60) + " min ago"
    }
    if seconds < 86400 {
        let minutes: u32 = (seconds % 3600) / 60
        if minutes == 0 {
            return rho_int_to_str(seconds / 3600) + " h ago"
        }
        return rho_int_to_str(seconds / 3600) + " h " + rho_int_to_str(minutes) + " min ago"
    }
    return rho_int_to_str(seconds / 86400) + " d ago"
}

/* -------------------------------------------------------------------------- */
/*  The agora of the active mesh                                              */
/* -------------------------------------------------------------------------- */

// agora_url is the address of a mesh's agora, with the gateway or a node (by
// its row) selected.
fn agora_url(id: string, node: string) string {
    if node == "" {
        return editor_base(id)
    }
    if node == "gateway" {
        return editor_page_url(id, "gateway")
    }
    let index: u32 = u32(rho_int_from_str(node))
    if index == 0 {
        return editor_base(id)
    }
    return editor_page_url(id, "node:" + project_node_id(project_file(id), index))
}

// agora_node_state is a card's live line: online, last seen, or why it has not
// reported.
fn agora_node_state(index: u32, readings: string) string {
    if is_module_node(index) {
        return ""
    }
    let source: string = state_value("node." + rho_int_to_str(index) + ".id")
    let last: u32 = agora_last_seen(readings, source)
    if last > 0 && mesh_now_seconds() - last <= AGORA_ONLINE_SECONDS {
        return "<span class=\"agora-state online\">online</span> <span class=\"agora-seen\">last seen " +
            agora_age(last) + "</span>"
    }
    if last > 0 {
        return "<span class=\"agora-state stale\">quiet</span> <span class=\"agora-seen\">last seen " +
            agora_age(last) + "</span>"
    }
    if is_device_node(index) {
        return "<span class=\"agora-state quiet\">no readings yet</span>"
    }
    return "<span class=\"agora-state quiet\">no readings</span>"
}

// agora_node_deploy is a board's line when it does not run what is planned.
fn agora_node_deploy(index: u32) string {
    if is_module_node(index) || is_device_node(index) {
        return ""
    }
    let reason: string = deployed_node_reason(current_project(), index)
    if reason == "" {
        return ""
    }
    return "<div class=\"agora-live\"><span class=\"agora-state planned\">out of date</span> <span class=\"agora-seen\">" +
        escape_html(reason) + "</span></div>"
}

fn agora_node_live(index: u32, readings: string) string {
    if is_module_node(index) {
        return ""
    }
    let source: string = state_value("node." + rho_int_to_str(index) + ".id")
    return jobs_card_line(current_project(), "node." + state_value("node." + rho_int_to_str(index) + ".id")) +
        agora_node_deploy(index) + "<div class=\"agora-live\">" + agora_node_state(index, readings) +
        "<div class=\"agora-chips\">" + agora_chips(readings, source, 3) + "</div></div>"
}

fn agora_node_card(id: string, index: u32, readings: string) string {
    let role: string = node_value(index, "role", "node")
    var add: string = ""
    if !is_module_node(index) && !is_device_node(index) {
        let row: string = "node." + rho_int_to_str(index)
        add = "<span class=\"agora-add\"><a" + editor_open_new(id, "module", row) + ">+ module</a>" +
            "<a" + editor_open_new(id, "device", row) + ">+ device</a>" +
            "<a" + editor_open_new(id, "compute", row) + ">+ node</a></span>"
    }
    return "<span class=\"agora-node\" id=\"agora-node-" + rho_int_to_str(index) + "\">" +
        "<a class=\"node-card " + escape_html(role) + " agora-card\"" + editor_open_node(id, index, "") + ">" +
        node_card_body(index) + agora_node_live(index, readings) + "</a>" + add + "</span>"
}

// agora_link_badge is the link a board hangs from, which opens the link's
// editor.
fn agora_link_badge(id: string, index: u32) string {
    return "<a class=\"link-badge\"" + editor_open_edge(id, index) + " title=\"Edit this link\">" +
        escape_html(link_label(node_value(index, "link", "uart"))) + "</a>"
}

fn agora_gateway_card(id: string, readings: string) string {
    let health: string = agora_health(id)
    var state: string = "<span class=\"agora-state quiet\">not checked yet</span>"
    if health == "online" {
        state = "<span class=\"agora-state online\">online</span> <span class=\"agora-seen\">since " +
            agora_age(agora_health_since(id)) + "</span>"
    } else if health == "offline" {
        state = "<span class=\"agora-state down\">not answering</span> <span class=\"agora-seen\">since " +
            agora_age(agora_health_since(id)) + "</span>"
    } else if health == "stopped" {
        state = "<span class=\"agora-state quiet\">not started</span>"
    } else if health == "none" {
        state = "<span class=\"agora-state planned\">no gateway planned</span>"
    }
    var deploy: string = ""
    let reason: string = deployed_gateway_reason(id)
    if reason != "" && reason != "never programmed" {
        deploy = "<div class=\"agora-live\"><span class=\"agora-state planned\">restart to apply</span> " +
            "<span class=\"agora-seen\">" + escape_html(reason) + "</span></div>"
    }
    let live: string = jobs_card_line(id, "gateway") + deploy + "<div class=\"agora-live\">" + state +
        "<div class=\"agora-seen\">" + escape_html(agora_host_label(id)) + "</div></div>"
    return "<span class=\"agora-node\" id=\"agora-node-gateway\"><a class=\"node-card gateway agora-card\"" +
        editor_open_gateway(id) + ">" + gateway_card_body() + live + "</a>" +
        "<span class=\"agora-add\"><a" + editor_open_new(id, "compute", "gateway") + ">+ node</a>" +
        "<a" + editor_open_new(id, "device", "gateway") + ">+ device</a></span></span>"
}

// agora_host_label says where a mesh's gateway runs and on which port.
fn agora_host_label(id: string) string {
    let kind: string = agora_gateway_kind(id)
    if kind == "" {
        return "no gateway planned"
    }
    if kind == "native" {
        return "this machine · native gateway · :" + agora_gateway_port(id)
    }
    return agora_gateway_host(id) + " · " + kind + " · :" + agora_gateway_port(id)
}

fn agora_child_items(id: string, parent: string, readings: string) string {
    var out: string = ""
    var index: u32 = 1
    let count: u32 = node_count()
    while index <= count {
        if node_value(index, "parent", "gateway") == parent && node_attached(index) {
            if is_module_node(index) || is_device_node(index) {
                var label: string = "module"
                if is_device_node(index) {
                    label = "device"
                }
                out = out + mesh_branch(mesh_badge(label, true), agora_node_card(id, index, readings), "", "", true)
            } else {
                out = out + mesh_branch(
                    agora_link_badge(id, index),
                    agora_node_card(id, index, readings), "",
                    agora_children(id, "node." + rho_int_to_str(index), readings), false)
            }
        }
        index = index + 1
    }
    return out
}

fn agora_children(id: string, parent: string, readings: string) string {
    let items: string = agora_child_items(id, parent, readings)
    if items == "" {
        return ""
    }
    return template_fill(template_get("mesh-children"), vars("items", items))
}

// agora_tree is the active mesh as a live tree: the same drawing the plan
// uses, each card with what the mesh reports about it.
fn agora_tree(id: string) string {
    let readings: string = agora_readings(id)
    var items: string = agora_child_items(id, "gateway", readings)
    var index: u32 = 1
    let count: u32 = node_count()
    while index <= count {
        if is_device_node(index) && node_value(index, "parent", "") == "mesh" && node_attached(index) {
            items = items + mesh_branch(mesh_badge("device", true), agora_node_card(id, index, readings), "", "", true)
        }
        index = index + 1
    }
    items = items + agora_linked_items(id)
    var out: string = agora_gateway_card(id, readings)
    if items != "" {
        out = out + template_fill(template_get("mesh-children"), vars("items", items))
    }
    if count == 0 {
        out = out + agora_first_run(id)
    }
    return out
}

// agora_linked_items are the meshes that report through this one's gateway,
// each a node that opens to show its own tree, and opens its own agora.
fn agora_linked_items(id: string) string {
    var out: string = ""
    var rest: string = link_children(id)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var child: string = rest
        if at < 0 {
            rest = ""
        } else {
            child = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if child == "" {
            continue
        }
        let health: string = agora_health(child)
        var state: string = "<span class=\"agora-state quiet\">" + escape_html(health) + "</span>"
        if health == "online" {
            state = "<span class=\"agora-state online\">online</span>"
        }
        let card: string = "<details class=\"node-card gateway agora-linked\"><summary><b>" + escape_html(project_name(child)) +
            "</b> <small class=\"agora-seen\">mesh · area " + escape_html(project_area_id(project_file(child))) +
            " · reports through this gateway</small> " + state + "</summary><div class=\"mini-tree\">" +
            fleet_tree_svg(child, health != "online") + "</div><p><a href=\"/mesh/p/" + escape_html(child) +
            "\">Open its agora</a></p></details>"
        out = out + mesh_branch("<span class=\"link-badge\">relay</span>", card, "", "", false)
    }
    return out
}

// agora_first_run is a new mesh's guide, on the canvas it will be used on:
// where the gateway runs, the first node, and applying. Each points at the
// control that does it, and the guide goes once the mesh has a node.
fn agora_first_run(id: string) string {
    var gateway: string = "agora-step"
    if state_value_in(project_file(id), "gateway") != "" {
        gateway = "agora-step done"
    }
    return "<ol class=\"agora-guide\">" +
        "<li class=\"" + gateway + "\"><a" + editor_open_gateway(id) + "><b>Choose where the gateway runs</b>" +
        "<span>This machine, or a board that can be a gateway. Its ports are already this mesh's own.</span></a></li>" +
        "<li class=\"agora-step\"><a" + editor_open_new(id, "compute", "gateway") + "><b>Add the first node</b>" +
        "<span>+ node on the gateway: a board, the link it reaches the gateway over, and its modules.</span></a></li>" +
        "<li class=\"agora-step\"><a" + editor_open(editor_base(id) + "/apply", editor_page_url(id, "apply")) + ">" +
        "<b>Apply</b><span>Builds what changed, starts the gateway, and asks you to put each board in its programming mode.</span></a></li></ol>"
}

// agora_out_of_date counts the boards that need building: planned or changed
// since they were last built.
fn agora_out_of_date() u32 {
    return fleet_line_count(deployed_out_of_date(current_project()))
}

fn agora_bar(id: string) string {
    let health: string = agora_health(id)
    var live: string = "<span class=\"agora-state quiet\">gateway not checked yet</span>"
    if health == "online" {
        live = "<span class=\"agora-state online\">Live · gateway online</span>"
    } else if health == "offline" {
        live = "<span class=\"agora-state down\">gateway not answering for " +
            rho_str_slice(agora_age(agora_health_since(id)), 0, u32(rho_strlen(agora_age(agora_health_since(id)))) - 4) + "</span>"
    } else if health == "stopped" {
        live = "<span class=\"agora-state quiet\">gateway not started</span>"
    } else if health == "none" {
        live = "<span class=\"agora-state planned\">no gateway planned</span>"
    }
    if rho_str_eq(state_value_in(project_file(id), "status.gateway"), "failed") {
        live = live + " <span class=\"agora-state down\">" +
            escape_html(state_value_in(project_file(id), "message.build")) +
            " <a href=\"/mesh/build/gateway?project=" + escape_html(id) + "\">The output</a></span>"
    }
    var stale: string = ""
    let count: u32 = agora_out_of_date()
    var waiting: string = "Apply changes"
    if count == 1 {
        waiting = "Apply changes · 1 board"
    } else if count > 1 {
        waiting = "Apply changes · " + rho_int_to_str(count) + " boards"
    }
    if count > 0 || deployed_gateway_reason(id) != "" {
        stale = "<a class=\"button\"" + editor_open(editor_base(id) + "/apply", editor_page_url(id, "apply")) + ">" +
            waiting + "</a>"
    }
    return "<strong class=\"agora-name\">" + escape_html(project_name(id)) + "</strong> " + live +
        " " + agora_gateway_actions(id, health) +
        " <span class=\"agora-pill\">area " + escape_html(project_area_id(project_file(id))) + "</span> " + stale +
        " <span class=\"agora-links\"><a href=\"/mesh/project/" + escape_html(id) + "/settings\">Settings</a> · " +
        "<a href=\"/mesh/fleet\">Fleet</a></span>"
}

// agora_gateway_actions are the controls of a mesh's gateway. A native one is
// built from the gateway's sources and started here; a board's is built and
// programmed on the gateway's build page.
fn agora_gateway_actions(id: string, health: string) string {
    if agora_gateway_kind(id) != "native" {
        return "<a class=\"button quiet\" href=\"/mesh/build/gateway?project=" + escape_html(id) +
            "\">Build and program the gateway</a>"
    }
    let project: string = "<input type=\"hidden\" name=\"project\" value=\"" + escape_html(id) + "\">" +
        "<input type=\"hidden\" name=\"return\" value=\"agora\">"
    let job: string = jobs_open_for(id, "gateway", "")
    if job != "" {
        return "<a class=\"button quiet\"" + jobs_open_attrs(id, job) + ">" + escape_html(jobs_meta(id, job, "label")) +
            " · " + jobs_state(id, job) + "</a>"
    }
    var label: string = "Build and start the gateway"
    var stop: string = ""
    if health == "online" || health == "offline" {
        label = "Rebuild and restart the gateway"
        stop = "<form class=\"agora-action\" method=\"post\" action=\"/mesh/gateway/stop\">" + project +
            "<button type=\"submit\" class=\"quiet\">Stop</button></form>"
    }
    // The build runs in the background; the page shows the job and its log.
    return "<form class=\"agora-action\" method=\"post\" action=\"" + editor_base(id) + "/apply\" hx-post=\"" +
        editor_base(id) + "/apply\" hx-target=\"#agora-inspector\"><input type=\"hidden\" name=\"only\" value=\"gateway\">" +
        "<button type=\"submit\">" + label + "</button></form>" + stop
}

// agora_strip is the mesh's activity: its jobs, and its faults in one line —
// how many are open and the newest.
fn agora_strip(id: string) string {
    var count: u32 = 0
    var newest: string = ""
    var rest: string = telemetry_fault_rows(id, 100)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line == "" {
            continue
        }
        if newest == "" {
            newest = agora_fault_text(agora_tab(line, 3)) + " · " + agora_ms_age(agora_tab(line, 2))
        }
        count = count + 1
    }
    var faults: string = "<span>No faults.</span>"
    if count == 1 {
        faults = "<span class=\"fault\">1 fault · " + escape_html(newest) + "</span>"
    } else if count > 1 {
        faults = "<span class=\"fault\">" + rho_int_to_str(count) + " faults · newest: " + escape_html(newest) + "</span>"
    }
    var jobs: string = jobs_strip(id)
    if jobs == "" {
        jobs = "<span>No jobs running.</span>"
    }
    return jobs + faults + "<span class=\"ag-spacer\"></span><a href=\"/faults\">Faults</a>"
}

// agora_tab is one tab-separated field of a line.
fn agora_tab(line: string, index: u32) string {
    var rest: string = line
    var at: u32 = 0
    while at < index {
        let tab: i32 = rho_str_index_of(rest, "\t")
        if tab < 0 {
            return ""
        }
        rest = rho_str_slice(rest, u32(tab) + 1, u32(rho_strlen(rest)) - u32(tab) - 1)
        at = at + 1
    }
    let tab: i32 = rho_str_index_of(rest, "\t")
    if tab < 0 {
        return rest
    }
    return rho_str_slice(rest, 0, u32(tab))
}

// agora_ms_age is how long ago a time in milliseconds was. The milliseconds do
// not fit the number a string is read as, so the seconds are read instead.
fn agora_ms_age(ms: string) string {
    let length: u32 = u32(rho_strlen(ms))
    if length <= 3 {
        return "just now"
    }
    return agora_age(u32(rho_int_from_str(rho_str_slice(ms, 0, length - 3))))
}

// agora_fault_text is a fault's message as a person reads it: a failed poll's
// JSON answer, which a fault recorded before kept whole, is said in words.
fn agora_fault_text(message: string) string {
    let at: i32 = rho_str_index_of(message, "{\"")
    if at < 0 {
        return message
    }
    return rho_str_slice(message, 0, u32(at)) +
        mesh_poll_error_text(rho_str_slice(message, u32(at), u32(rho_strlen(message)) - u32(at)))
}

fn agora_plural(count: string, one: string, many: string) string {
    if count == "1" {
        return "<span><b>1</b> " + one + "</span>"
    }
    return "<span><b>" + count + "</b> " + many + "</span>"
}

fn agora_fact(label: string, value: string) string {
    var shown: string = value
    if shown == "" {
        shown = "—"
    }
    return "<dt>" + escape_html(label) + "</dt><dd>" + escape_html(shown) + "</dd>"
}

const AGORA_STYLE: string = "<style>.agora-bar{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;margin-bottom:1rem}.agora-name{font-size:1.15rem}.agora-action{display:inline}.agora-links{margin-left:auto}.agora{display:grid;grid-template-columns:minmax(0,1fr) 20rem;gap:1rem}@media (max-width:900px){.agora{grid-template-columns:1fr}}.agora-inspector{border:1px solid var(--line,#ccc);border-radius:10px;padding:.8rem 1rem;align-self:start}.agora-live{margin-top:.35rem;font-size:.82rem}.agora-state{display:inline-block;border-radius:999px;padding:.05rem .5rem;font-weight:600;font-size:.78rem}.agora-state.online{background:#d9f2e3;color:#145c32}.agora-state.down{background:#fbe0dc;color:#8a1f12}.agora-state.stale,.agora-state.quiet{background:#eceae4;color:#555}.agora-state.planned{background:#fff1cc;color:#7a5200}.agora-seen{color:#777;font-size:.8rem}.agora-chips{display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.3rem}.agora-chip{border:1px solid var(--line,#ddd);border-radius:6px;padding:.05rem .4rem;font-size:.8rem}.agora-pill{border:1px solid var(--line,#ccc);border-radius:999px;padding:.05rem .55rem;font-size:.8rem}.agora-strip{display:flex;flex-wrap:wrap;gap:.8rem;align-items:center;margin-top:1rem;border-top:1px solid var(--line,#ddd);padding-top:.6rem;font-size:.85rem}.agora-fault{color:#8a1f12}.agora-facts{display:grid;grid-template-columns:auto 1fr;gap:.2rem .8rem;margin:.4rem 0}.agora-facts dt{color:#777}.agora-facts dd{margin:0}</style>"

// mesh_agora_page is the old address of the agora, which is now the
// project's own: /mesh/p/<project>.
fn mesh_agora_page(req: Request) Response {
    mesh_follow_project(req)
    let id: string = current_project()
    if id == "" {
        return mesh_redirect("/mesh/fleet")
    }
    let node: string = request_query_param(req, "node")
    if node == "gateway" {
        return mesh_redirect("/mesh/p/" + id + "?select=gateway")
    }
    let index: u32 = u32(rho_int_from_str(node))
    if index > 0 && index <= node_count() {
        return mesh_redirect("/mesh/p/" + id + "?select=node:" + project_node_id(project_file(id), index))
    }
    return mesh_redirect("/mesh/p/" + id)
}

const EDITOR_STYLE: string = "<style>.agora-linked{min-width:16rem;cursor:pointer}.agora-linked summary{list-style:none}.agora-linked .mini-tree{margin:.5rem 0;height:74px;border-radius:9px;background:rgba(244,239,228,.03)}.agora-linked svg{width:100%;height:74px}.agora-job{border-radius:999px;padding:.1rem .6rem;font-size:.8rem;border:1px solid var(--line)}.agora-job.running{color:var(--gold);border-color:rgba(228,184,102,.5)}.agora-job.waiting{color:var(--warn);border-color:rgba(240,197,106,.6);font-weight:600}.agora-job.failed{color:var(--stop);border-color:rgba(240,138,126,.5)}.job-log{max-height:24rem;overflow:auto;font-size:.72rem;white-space:pre-wrap;background:rgba(0,0,0,.25);padding:.6rem;border-radius:8px}form.inline{display:inline}.agora-node{display:inline-flex;flex-direction:column;align-items:center;gap:.25rem}.agora-add{display:flex;gap:.3rem;opacity:.35;transition:opacity .15s}.agora-node:hover .agora-add,.agora-node:focus-within .agora-add{opacity:1}.agora-add a{font-size:.72rem;border:1px dashed var(--line-strong);border-radius:999px;padding:.05rem .45rem;color:var(--muted)}.agora-add a:hover{color:var(--ink);border-color:var(--gold)}a.link-badge{cursor:pointer}a.link-badge:hover{outline:1px solid var(--gold)}.agora-inspector h3{margin:.1rem 0 .5rem}.inspector-tabs{display:flex;gap:.25rem;margin:.5rem 0 .7rem;border-bottom:1px solid var(--line)}.inspector-tabs a{padding:.3rem .6rem;font-size:.8rem;color:var(--muted);border-bottom:2px solid transparent}.inspector-tabs a.on{color:var(--ink);border-bottom-color:var(--gold)}.inspector-form{display:grid;gap:.6rem;margin-bottom:.8rem}.inspector-form label{display:grid;gap:.2rem;font-size:.8rem}.inspector-list{margin:.3rem 0 .6rem;padding-left:1.1rem;font-size:.85rem}.inspector-list form.inline{display:inline;margin-left:.4rem}.inspector-deploy{margin:.2rem 0 .4rem;font-size:.82rem}.inspector-add{margin-top:.6rem}.agora-inspector .sensor-groups{max-height:18rem;overflow:auto}.agora-guide{list-style:none;counter-reset:step;display:grid;gap:.6rem;max-width:30rem;margin:1.2rem auto 0;padding:0}.agora-step{counter-increment:step}.agora-step a{display:grid;grid-template-columns:2rem 1fr;gap:.1rem .6rem;padding:.7rem .9rem;border:1px dashed var(--line-strong);border-radius:12px;color:var(--ink)}.agora-step a::before{content:counter(step);grid-row:span 2;display:grid;place-items:center;width:1.7rem;height:1.7rem;border-radius:50%;border:1px solid var(--gold);color:var(--gold);font-weight:700}.agora-step a span{color:var(--muted);font-size:.82rem}.agora-step a:hover,.agora-step a:focus{border-color:var(--gold)}.agora-step.done a{opacity:.55;border-style:solid}.agora-step.done a::before{content:'✓'}@media (max-width:700px){.agora-inspector{position:fixed;left:0;right:0;bottom:0;max-height:55vh;overflow:auto;z-index:30;border-radius:14px 14px 0 0;background:var(--panel-strong);box-shadow:0 -12px 30px rgba(0,0,0,.45)}.agora-canvas{padding-bottom:40vh}}</style>"

// agora_page_for is a mesh's agora with something selected: the bar, the live
// tree on its canvas, the inspector beside it, and the activity strip.
fn agora_page_for(req: Request, id: string, selection: string, tab: string, kind: string, parent: string) Response {
    var highlight: string = ""
    if selection == "gateway" {
        highlight = "<style>#agora-node-gateway .ag-card{outline:2px solid var(--gold);outline-offset:2px}</style>"
    } else if rho_str_index_of(selection, "node:") == 0 || rho_str_index_of(selection, "edge:") == 0 {
        let index: u32 = project_node_by_id(project_file(id), rho_str_slice(selection, 5, u32(rho_strlen(selection)) - 5))
        if index > 0 {
            highlight = "<style>#agora-node-" + rho_int_to_str(index) +
                " .ag-card{outline:2px solid var(--gold);outline-offset:2px}</style>"
        }
    }
    let zoom: string = "var z=document.getElementById('agora-zoom');z.style.transform='scale('+(z.dataset.z=Math.max(.4,Math.min(1.6,(+z.dataset.z||1)"
    let tools: string = "<div class=\"ag-tools\"><button class=\"ag-btn small\" type=\"button\" onclick=\"var z=document.getElementById('agora-zoom');z.dataset.z=1;z.style.transform=''\">Fit</button>" +
        "<button class=\"ag-btn small\" type=\"button\" onclick=\"" + zoom + "-.1)))+')'\">−</button>" +
        "<button class=\"ag-btn small\" type=\"button\" onclick=\"" + zoom + "+.1)))+')'\">+</button>" +
        "<a class=\"ag-btn small\"" + editor_open_new(id, "compute", "gateway") + ">Add node</a>" +
        "<a class=\"ag-btn small\"" + editor_open_new(id, "device", "gateway") + ">Add device</a></div>"
    let body: string = AGORA_STYLE + EDITOR_STYLE + LOOK_STYLE + highlight +
        "<div class=\"ag-app\" data-base=\"" + editor_base(id) + "\" hx-ext=\"sse\" sse-connect=\"/mesh/agora/events?project=" + escape_html(id) + "\">" +
        "<div class=\"ag-bar\" id=\"agora-bar\" sse-swap=\"agora-bar\" hx-swap=\"innerHTML\">" + look_bar(id) + "</div>" +
        "<div class=\"ag-body\"><section class=\"ag-canvas\">" + tools + "<div class=\"ag-zoom\" id=\"agora-zoom\">" +
        "<div class=\"mesh-tree agora-canvas\" id=\"agora-canvas\" sse-swap=\"agora-tree\" hx-swap=\"innerHTML\">" +
        look_tree(id, "") + "</div></div></section><aside class=\"agora-inspector\" id=\"agora-inspector\">" +
        editor_inspector(id, selection, tab, kind, parent, "") + "</aside></div>" +
        "<div class=\"ag-strip\" sse-swap=\"agora-strip\" hx-swap=\"innerHTML\">" + agora_strip(id) + "</div>" + LOOK_DRAG + "</div>"
    // The agora is the whole window, not a panel in a page.
    return html(status_ok(), look_translate(req, mesh_shell(req, project_name(id) + " · live", mesh_with_project(body))))
}

fn agora_events_file(id: string) string {
    return project_location(id) + "/agora-events.jsonl"
}

fn agora_snapshot(id: string) string {
    return mesh_event_json("agora-bar", look_bar(id)) +
        mesh_event_json("agora-tree", look_tree(id, "")) +
        mesh_event_json("agora-strip", agora_strip(id))
}

// mesh_agora_events is the agora's one stream: the regions as they are now,
// then each region again whenever what it shows changes.
fn mesh_agora_events(req: Request) Response {
    let id: string = request_query_param(req, "project")
    if id == "" || id != current_project() {
        return text(status_not_found(), "no such mesh is open\n")
    }
    let snapshot: string = project_location(id) + "/agora-snapshot.jsonl"
    rho_write_text(snapshot, agora_snapshot(id))
    rho_append_text(agora_events_file(id), "")
    return sse_events(agora_events_file(id), snapshot, 1000)
}

/* -------------------------------------------------------------------------- */
/*  The fleet                                                                 */
/* -------------------------------------------------------------------------- */

// fleet_counts are a mesh's boards and devices: "boards|devices".
fn fleet_counts(file: string) string {
    let count: u32 = project_node_count_at(file)
    var boards: u32 = 0
    var devices: u32 = 0
    var index: u32 = 1
    while index <= count {
        let kind: string = project_node_value(file, index, "kind", "compute")
        if kind == "device" {
            devices = devices + 1
        } else if kind != "module" {
            boards = boards + 1
        }
        index = index + 1
    }
    return rho_int_to_str(boards) + "|" + rho_int_to_str(devices)
}

// fleet_children are the rows whose parent is `parent`, as "index\n" lines.
fn fleet_children(file: string, parent: string) string {
    var out: string = ""
    let count: u32 = project_node_count_at(file)
    var index: u32 = 1
    while index <= count {
        if project_node_value(file, index, "parent", "gateway") == parent {
            out = out + rho_int_to_str(index) + "\n"
        }
        index = index + 1
    }
    return out
}

fn fleet_line_count(lines: string) u32 {
    var count: u32 = 0
    var rest: string = lines
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        if at < 0 {
            return count + 1
        }
        count = count + 1
        rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
    }
    return count
}

fn fleet_line(lines: string, wanted: u32) string {
    var rest: string = lines
    var at_line: u32 = 0
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if at_line == wanted {
            return line
        }
        at_line = at_line + 1
    }
    return ""
}

// fleet_kind_colour is the colour a row is drawn in: the gateway gold, a board
// blue, a device teal, a module violet, and everything grey while the gateway
// is down.
fn fleet_kind_colour(kind: string, down: bool) string {
    if down {
        return "#5a5f5c"
    }
    if kind == "device" {
        return "#79c7bd"
    }
    if kind == "module" {
        return "#c3aef0"
    }
    return "#8ab4e8"
}

// fleet_tree_svg is a mesh's tree drawn small: the gateway at the top, what
// hangs from it below with the links between, and under each of those what
// hangs from it in turn.
fn fleet_tree_svg(id: string, down: bool) string {
    let file: string = project_file(id)
    let top: string = fleet_children(file, "gateway")
    let n: u32 = fleet_line_count(top)
    var lines: string = ""
    var dots: string = ""
    var gateway_colour: string = "#e4b866"
    if down {
        gateway_colour = "#5a5f5c"
    }
    var stroke: string = "rgba(244,239,228,.3)"
    if down {
        stroke = "rgba(244,239,228,.18)"
    }
    var i: u32 = 0
    while i < n {
        let index: u32 = u32(rho_int_from_str(fleet_line(top, i)))
        let x: u32 = (200 * (2 * i + 1)) / (2 * n)
        lines = lines + "M100 20 V30 H" + rho_int_to_str(x) + " V44 "
        dots = dots + "<circle cx=\"" + rho_int_to_str(x) + "\" cy=\"50\" r=\"5\" fill=\"" +
            fleet_kind_colour(project_node_value(file, index, "kind", "compute"), down) + "\"><title>" +
            escape_html(project_node_value(file, index, "name", "Node " + rho_int_to_str(index))) + "</title></circle>"
        let below: string = fleet_children(file, "node." + rho_int_to_str(index))
        var m: u32 = fleet_line_count(below)
        if m > 4 {
            m = 4
        }
        var j: u32 = 0
        while j < m {
            let child: u32 = u32(rho_int_from_str(fleet_line(below, j)))
            // Up to four under each, side by side under their parent.
            let cx: u32 = u32(i32(x) + i32(9 * j) - i32((9 * (m - 1)) / 2))
            lines = lines + "M" + rho_int_to_str(x) + " 55 V59 H" + rho_int_to_str(cx) + " V62 "
            dots = dots + "<circle cx=\"" + rho_int_to_str(cx) + "\" cy=\"65\" r=\"3\" fill=\"" +
                fleet_kind_colour(project_node_value(file, child, "kind", "compute"), down) + "\"><title>" +
                escape_html(project_node_value(file, child, "name", "Node " + rho_int_to_str(child))) + "</title></circle>"
            j = j + 1
        }
        i = i + 1
    }
    var path: string = ""
    if lines != "" {
        path = "<g stroke=\"" + stroke + "\" stroke-width=\"1.2\" fill=\"none\"><path d=\"" + lines + "\"/></g>"
    }
    return "<svg viewBox=\"0 0 200 74\" aria-hidden=\"true\">" + path +
        "<circle cx=\"100\" cy=\"14\" r=\"6\" fill=\"" + gateway_colour + "\"><title>Gateway</title></circle>" +
        dots + "</svg>"
}

// fleet_under is a linked mesh's card saying which mesh it reports through.
fn fleet_under(id: string) string {
    let parent: string = link_parent(id)
    if parent == "" {
        return ""
    }
    return " · under " + escape_html(project_name(parent))
}

// fleet_link_notes say which mesh reports through which, under the cards.
fn fleet_link_notes() string {
    var out: string = ""
    var rest: string = agora_project_ids()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var id: string = rest
        if at < 0 {
            rest = ""
        } else {
            id = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        let parent: string = link_parent(id)
        if id != "" && parent != "" {
            out = out + "<span class=\"link-note\"><i></i> " + escape_html(project_name(id)) + " reports through " +
                escape_html(project_name(parent)) + "'s gateway as area " + escape_html(project_area_id(project_file(id))) +
                ", over the authenticated uplink</span>"
        }
    }
    return out
}

fn fleet_card(id: string) string {
    let file: string = project_file(id)
    let counts: string = fleet_counts(file)
    let readings: string = agora_readings(id)
    let health: string = agora_health(id)
    var css: string = ""
    var state: string = "<span class=\"agora-state quiet\">not checked yet</span>"
    var down: bool = false
    if health == "online" {
        state = "<span class=\"agora-state online\">online</span>"
    } else if health == "offline" {
        css = " down"
        down = true
        state = "<span class=\"agora-state down\">gateway down</span>"
    } else if health == "stopped" {
        down = true
        state = "<span class=\"agora-state quiet\">gateway not started</span>"
    } else if health == "none" {
        state = "<span class=\"agora-state planned\">no gateway</span>"
    }
    var last: string = "no readings yet"
    let newest: u32 = agora_newest(readings)
    if newest > 0 {
        last = "last reading " + agora_age(newest)
    } else if health == "offline" {
        last = "since " + agora_age(agora_health_since(id))
    }
    var stale: string = ""
    if rho_str_eq(id, current_project()) {
        let out_of_date: u32 = agora_out_of_date()
        if out_of_date > 0 {
            css = css + " warn"
            stale = "<span><b>" + rho_int_to_str(out_of_date) + "</b> to build</span>"
        }
    }
    var boards: string = agora_plural(field(counts, 0), "node", "nodes")
    if field(counts, 1) != "0" {
        boards = boards + agora_plural(field(counts, 1), "device", "devices")
    }
    return "<a class=\"mesh-card" + css + "\" href=\"" + agora_url(id, "") + "\">" +
        "<div class=\"row\"><span class=\"name\">" + escape_html(project_name(id)) + "</span>" +
        "<span class=\"area\">area " + escape_html(project_area_id(file)) + fleet_under(id) + "</span></div>" +
        "<div class=\"sub\">" + escape_html(agora_host_label(id)) + "</div>" +
        "<div class=\"mini-tree\">" + fleet_tree_svg(id, down) + "</div>" +
        "<div class=\"stats\">" + boards + stale + agora_chips(readings, "", 2) + "</div>" +
        "<div class=\"row\">" + state + "<span class=\"sub\">" + last + "</span></div></a>"
}

fn fleet_cards() string {
    var out: string = ""
    var rest: string = agora_project_ids()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var id: string = rest
        if at < 0 {
            rest = ""
        } else {
            id = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if id != "" {
            out = out + fleet_card(id)
        }
    }
    return out + fleet_link_notes() + mesh_new_mesh_form()
}

// fleet_summary is the fleet's header line: how many meshes, how many hosts,
// and how many gateways answer.
fn fleet_summary() string {
    var meshes: u32 = 0
    var online: u32 = 0
    var hosts: string = "|"
    var host_count: u32 = 0
    var rest: string = agora_project_ids()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var id: string = rest
        if at < 0 {
            rest = ""
        } else {
            id = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if id == "" {
            continue
        }
        meshes = meshes + 1
        if agora_health(id) == "online" {
            online = online + 1
        }
        let host: string = agora_gateway_host(id)
        if rho_str_index_of(hosts, "|" + host + "|") < 0 {
            hosts = hosts + host + "|"
            host_count = host_count + 1
        }
    }
    var live: string = "live"
    if online < meshes {
        live = "quiet"
    }
    var mesh_word: string = " meshes · "
    if meshes == 1 {
        mesh_word = " mesh · "
    }
    var host_word: string = " hosts"
    if host_count == 1 {
        host_word = " host"
    }
    return "<span class=\"crumbs\"><b>Fleet</b> · " + rho_int_to_str(meshes) + mesh_word +
        rho_int_to_str(host_count) + host_word + "</span>" +
        "<span class=\"chip " + live + "\">" + rho_int_to_str(online) + " of " + rho_int_to_str(meshes) +
        " gateways online</span><span class=\"spacer\"></span>" + fleet_search_form("") + fleet_apply_all() +
        "<a class=\"button quiet\" href=\"#new-mesh\">New mesh</a>"
}

// fleet_apply_all is the bar's button that applies every mesh's changes, when
// there are any.
fn fleet_apply_all() string {
    let waiting: u32 = cross_changes_waiting()
    if waiting == 0 {
        return ""
    }
    var words: string = rho_int_to_str(waiting) + " changes waiting"
    if waiting == 1 {
        words = "1 change waiting"
    }
    return "<span class=\"chip\">" + words + "</span><form method=\"post\" action=\"/mesh/apply-all\" class=\"inline\">" +
        "<button type=\"submit\">Apply in all meshes</button></form>"
}

// fleet_jobs are a mesh's running and waiting jobs, as inbox items.
fn fleet_jobs(id: string) string {
    var out: string = ""
    var rest: string = jobs_list(id)
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var seq: string = rest
        if at < 0 {
            rest = ""
        } else {
            seq = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        let state: string = jobs_state(id, seq)
        if seq != "" && (state == "running" || state == "waiting") {
            out = out + "<a class=\"item job\" href=\"" + editor_page_url(id, "job:" + seq) + "\"><b>" +
                escape_html(project_name(id)) + " · " + escape_html(jobs_meta(id, seq, "label")) + "</b><span>" + state + "</span></a>"
        }
    }
    return out
}

// fleet_inbox is the faults of every mesh, newest first per mesh, each opening
// its mesh.
fn fleet_inbox() string {
    var out: string = ""
    var rest: string = agora_project_ids()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var id: string = rest
        if at < 0 {
            rest = ""
        } else {
            id = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if id == "" {
            continue
        }
        out = out + fleet_jobs(id)
        if agora_health(id) == "offline" {
            out = out + "<a class=\"item bad\" href=\"" + agora_url(id, "gateway") + "\"><b>" + escape_html(project_name(id)) +
                " · gateway not answering</b><span>" + agora_age(agora_health_since(id)) +
                " · opens the mesh with the gateway selected</span></a>"
        }
        var faults: string = telemetry_fault_rows(id, 3)
        while faults != "" {
            let end: i32 = rho_str_index_of(faults, "\n")
            var line: string = faults
            if end < 0 {
                faults = ""
            } else {
                line = rho_str_slice(faults, 0, u32(end))
                faults = rho_str_slice(faults, u32(end) + 1, u32(rho_strlen(faults)) - u32(end) - 1)
            }
            if line != "" {
                out = out + "<a class=\"item bad\" href=\"" + agora_url(id, "") + "\"><b>" + escape_html(project_name(id)) +
                    " · " + escape_html(agora_fault_text(agora_tab(line, 3))) + "</b><span>" +
                    agora_ms_age(agora_tab(line, 2)) + "</span></a>"
            }
        }
    }
    if out == "" {
        return "<h5>Across all meshes</h5><div class=\"item ok\"><b>Nothing needs attention.</b></div>"
    }
    return "<h5>Across all meshes</h5>" + out
}

// fleet_hosts lists the machines the meshes' gateways run on, with each mesh's
// ports there.
fn fleet_hosts() string {
    var hosts: string = ""
    var lines: string = ""
    var rest: string = agora_project_ids()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var id: string = rest
        if at < 0 {
            rest = ""
        } else {
            id = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if id == "" || agora_gateway_kind(id) == "" {
            continue
        }
        var host: string = agora_gateway_host(id)
        if agora_gateway_kind(id) == "native" {
            host = "this machine"
        }
        lines = lines + host + "\t" + "<div class=\"item\"><b>" + escape_html(host) + "</b><span>" + escape_html(project_name(id)) +
            " :" + escape_html(agora_gateway_port(id)) + " · uplink :" + escape_html(fleet_uplink_port(id)) + "</span></div>\n"
        if rho_str_index_of(hosts, "|" + host + "|") < 0 {
            hosts = hosts + "|" + host + "|"
        }
    }
    var out: string = ""
    rest = lines
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        let tab: i32 = rho_str_index_of(line, "\t")
        if tab >= 0 {
            out = out + rho_str_slice(line, u32(tab) + 1, u32(rho_strlen(line)) - u32(tab) - 1)
        }
    }
    if out == "" {
        return "<h5>Hosts</h5><div class=\"item\"><span>No gateway is planned yet.</span></div>"
    }
    return "<h5>Hosts</h5>" + out
}

// fleet_activity is the fleet's foot: how many meshes are down, and how many
// faults are open across them.
fn fleet_activity() string {
    var down: u32 = 0
    var faults: u32 = 0
    var meshes: u32 = 0
    var rest: string = agora_project_ids()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var id: string = rest
        if at < 0 {
            rest = ""
        } else {
            id = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if id == "" {
            continue
        }
        meshes = meshes + 1
        if agora_health(id) == "offline" {
            down = down + 1
        }
        faults = faults + fleet_line_count(telemetry_fault_rows(id, 100))
    }
    var out: string = "<span>" + rho_int_to_str(meshes) + " meshes</span>"
    if meshes == 1 {
        out = "<span>1 mesh</span>"
    }
    if down == 1 {
        out = out + "<span class=\"fault\">1 mesh down</span>"
    } else if down > 1 {
        out = out + "<span class=\"fault\">" + rho_int_to_str(down) + " meshes down</span>"
    }
    if faults > 0 {
        out = out + "<span class=\"fault\">" + rho_int_to_str(faults) + " open faults</span>"
    }
    return out + "<span class=\"spacer\"></span><a href=\"/faults\">Faults</a>"
}

fn fleet_regions() string {
    return mesh_event_json("fleet-bar", fleet_summary()) +
        mesh_event_json("fleet-cards", fleet_cards()) +
        mesh_event_json("fleet-side", fleet_inbox() + fleet_hosts()) +
        mesh_event_json("fleet-activity", fleet_activity())
}

const FLEET_STYLE: string = "<style>.fleet-panel{display:grid;grid-template-rows:auto 1fr auto;min-height:calc(100vh - 9rem);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--panel-strong)}.fleet-panel .fbar{display:flex;gap:.8rem;align-items:center;padding:.7rem 1.1rem;border-bottom:1px solid var(--line);background:rgba(7,15,19,.6)}.fleet-panel .crumbs{font-size:.9rem;color:var(--muted)}.fleet-panel .crumbs b{color:var(--ink)}.fleet-panel .chip{font-size:.76rem;border-radius:999px;padding:.12rem .6rem;border:1px solid var(--line)}.fleet-panel .chip.live{color:var(--teal);border-color:rgba(121,199,189,.45);background:var(--accent-soft)}.fleet-panel .chip.quiet{color:var(--muted)}.fleet-panel .spacer{flex:1}.fleet-body{display:grid;grid-template-columns:minmax(0,1fr) 300px;min-height:0}@media (max-width:900px){.fleet-body{grid-template-columns:1fr}}.fleet-grid{padding:22px;display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:18px;align-content:start;background-image:radial-gradient(rgba(244,239,228,.06) 1px,transparent 1px);background-size:22px 22px}.mesh-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:13px 14px;display:grid;gap:9px;color:inherit;text-decoration:none}.mesh-card:hover{border-color:var(--line-strong)}.mesh-card.warn{border-color:rgba(240,197,106,.45)}.mesh-card.down{border-color:rgba(240,138,126,.5)}.mesh-card .row{display:flex;justify-content:space-between;align-items:center;gap:8px}.mesh-card .name{font:500 1.08rem/1.2 var(--serif);color:var(--ink)}.mesh-card .sub{font-size:.74rem;color:var(--faint)}.mini-tree{height:74px;border-radius:9px;background:rgba(244,239,228,.03);border:1px solid rgba(244,239,228,.08);display:grid;place-items:center}.mini-tree svg{width:100%;height:74px}.mesh-card .stats{display:flex;gap:12px;font-size:.74rem;color:var(--muted);flex-wrap:wrap;align-items:center}.mesh-card .stats b{color:var(--ink);font-weight:600}.mesh-card .area{font:700 .62rem/1 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--blue);border:1px solid rgba(138,180,232,.35);padding:3px 6px;border-radius:5px}.link-note{grid-column:1/-1;font-size:.74rem;color:var(--faint);display:flex;gap:8px;align-items:center}.link-note i{display:inline-block;width:36px;border-top:1.5px dashed var(--blue)}.agora-linked{min-width:16rem;cursor:pointer}.agora-linked summary{list-style:none}.agora-linked .mini-tree{margin:.5rem 0;height:74px}.agora-linked svg{width:100%;height:74px}.new-mesh{border:1.5px dashed rgba(244,239,228,.22);border-radius:14px;display:grid;gap:.5rem;align-content:center;justify-items:center;color:var(--faint);font-size:.84rem;min-height:150px;text-align:center;padding:12px}.new-mesh:focus-within{border-color:var(--gold);color:var(--ink)}.new-mesh input{width:100%}.fleet-search input{min-width:14rem;font-size:.82rem}.fleet-panel form.inline{display:inline}.inbox{border-left:1px solid var(--line);background:rgba(7,15,19,.78);padding:14px 16px;display:grid;gap:10px;align-content:start}.inbox h5{margin:.2rem 0 0;font:700 .66rem/1 var(--sans);letter-spacing:.13em;text-transform:uppercase;color:var(--faint)}.inbox .item{display:grid;gap:2px;font-size:.78rem;padding:8px 10px;border-radius:9px;background:rgba(244,239,228,.04);color:var(--ink)}.inbox .item span{color:var(--faint);font-size:.72rem}.inbox .item.bad{border-left:3px solid var(--stop)}.inbox .item.job{border-left:3px solid var(--gold)}.inbox .item.ok{border-left:3px solid var(--teal)}.fleet-panel .activity{display:flex;gap:22px;align-items:center;padding:9px 18px;border-top:1px solid var(--line);background:rgba(7,15,19,.82);font-size:.78rem;color:var(--muted)}.fleet-panel .activity .fault{color:var(--stop)}.fleet-panel .activity .spacer{flex:1}</style>"

// mesh_reads_every_mesh is whether a person may see the whole fleet: the live
// fleet is the same stream for everyone who opens it, so it is only for those.
fn mesh_reads_every_mesh(req: Request) bool {
    let scopes: string = mesh_scopes(req)
    return scopes == "" || mesh_scope_held(scopes, "*") || mesh_scope_held(scopes, "mesh:*") || mesh_scope_held(scopes, "mesh:read")
}

// mesh_fleet_limited is the fleet of someone granted particular meshes: their
// cards, without the live stream, which would show the others.
fn mesh_fleet_limited(req: Request) Response {
    var cards: string = ""
    var rest: string = agora_project_ids()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var id: string = rest
        if at < 0 { rest = "" } else { id = rho_str_slice(rest, 0, u32(at)); rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1) }
        if id != "" && mesh_may(req, id, false) {
            cards = cards + fleet_card(id)
        }
    }
    if cards == "" {
        cards = "<p>No mesh is granted to you yet. An admin of the keeper can grant one under Users &amp; access.</p>"
    }
    let body: string = AGORA_STYLE + FLEET_STYLE +
        "<div class=\"fleet-panel\"><div class=\"fbar\"><span class=\"crumbs\"><b>Your meshes</b></span></div>" +
        "<div class=\"fleet-body\" style=\"grid-template-columns:1fr\"><div class=\"fleet-grid\">" + cards + "</div></div><div class=\"activity\"></div></div>"
    return html(status_ok(), look_translate(req, mesh_shell(req, "Fleet", body)))
}

fn mesh_fleet_page(req: Request) Response {
    ensure_wizard_dir()
    if !mesh_reads_every_mesh(req) {
        return mesh_fleet_limited(req)
    }
    let body: string = AGORA_STYLE + FLEET_STYLE +
        "<div class=\"fleet-panel\" hx-ext=\"sse\" sse-connect=\"/mesh/fleet/events\">" +
        "<div class=\"fbar\" sse-swap=\"fleet-bar\" hx-swap=\"innerHTML\">" + fleet_summary() + "</div>" +
        "<div class=\"fleet-body\"><div class=\"fleet-grid\" sse-swap=\"fleet-cards\" hx-swap=\"innerHTML\">" + fleet_cards() + "</div>" +
        "<aside class=\"inbox\" sse-swap=\"fleet-side\" hx-swap=\"innerHTML\">" + fleet_inbox() + fleet_hosts() + "</aside></div>" +
        "<div class=\"activity\" sse-swap=\"fleet-activity\" hx-swap=\"innerHTML\">" + fleet_activity() + "</div></div>"
    return html(status_ok(), look_translate(req, mesh_shell(req, "Fleet", body)))
}

fn fleet_events_file() string {
    return wizard_dir() + "/fleet-events.jsonl"
}

fn mesh_fleet_events(req: Request) Response {
    if !mesh_reads_every_mesh(req) {
        return mesh_denied(req)
    }
    let snapshot: string = wizard_dir() + "/fleet-snapshot.jsonl"
    rho_write_text(snapshot, fleet_regions())
    rho_append_text(fleet_events_file(), "")
    return sse_events(fleet_events_file(), snapshot, 1000)
}

/* -------------------------------------------------------------------------- */
/*  The background pass                                                       */
/* -------------------------------------------------------------------------- */

// agora_publish appends a stream's regions to its events file when they differ
// from what it last sent, keeping the file short.
fn agora_publish(events: string, last_file: string, regions: string) void {
    if rho_str_eq(rho_read_text(last_file), regions) {
        return
    }
    rho_write_text(last_file, regions)
    if u32(rho_strlen(rho_read_text(events))) > 262144 {
        rho_write_text(events, "")
    }
    rho_append_text(events, regions)
}

// agora_tick checks every mesh's gateway and sends the fleet, and the active
// mesh's agora, whatever has changed. The background worker calls it.
fn agora_tick() void {
    var rest: string = agora_project_ids()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var id: string = rest
        if at < 0 {
            rest = ""
        } else {
            id = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if id != "" {
            agora_check_health(id)
        }
    }
    agora_publish(fleet_events_file(), wizard_dir() + "/fleet-last.jsonl", fleet_regions())
    let active: string = current_project()
    if active != "" && rho_path_exists(project_file(active)) {
        agora_publish(agora_events_file(active), project_location(active) + "/agora-last.jsonl", agora_snapshot(active))
    }
}
