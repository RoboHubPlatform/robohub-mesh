//
// @file deployed.rho
// @brief What each board of a mesh was last programmed with, and whether the plan has moved on.
//
// The plan says what a mesh should be; this file says what it is. When a board
// is programmed, or the gateway started, the signature of what it was built
// from (domain/deploy.rho) is recorded beside the project, under the board's
// stable id. A board whose signature now differs is out of date, and the
// difference says why. Nothing here resets anything: an edit is saved, and the
// boards it touches are the ones that show as out of date.
//
// @module mesh.deployed
// @project mesh
// @author Aurel Miron
// @date 2026-11-12
//
// SPDX-License-Identifier: MIT
//

module mesh.deployed

fn deployed_file(project: string) string {
    return project_location(project) + "/deployed.txt"
}

// deployed_get is the signature recorded under a key: "node.<id>" or
// "gateway". The file is tab-separated lines, since a signature holds `=`.
fn deployed_get(project: string, key: string) string {
    var rest: string = rho_read_text(deployed_file(project))
    let prefix: string = key + "\t"
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if rho_str_index_of(line, prefix) == 0 {
            return rho_str_slice(line, u32(rho_strlen(prefix)), u32(rho_strlen(line)) - u32(rho_strlen(prefix)))
        }
    }
    return ""
}

fn deployed_set(project: string, key: string, value: string) void {
    let path: string = deployed_file(project)
    rho_lock("mesh.deployed:" + path)
    var out: string = ""
    var rest: string = rho_read_text(path)
    let prefix: string = key + "\t"
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var line: string = rest
        if at < 0 {
            rest = ""
        } else {
            line = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if line != "" && rho_str_index_of(line, prefix) != 0 {
            out = out + line + "\n"
        }
    }
    if value != "" {
        out = out + key + "\t" + value + "\n"
    }
    ignore_bool(write_state_file(path, out))
    rho_unlock("mesh.deployed:" + path)
}

fn deployed_plan(project: string) string {
    return plan_text(project_file(project))
}

fn deployed_node_key(project: string, index: u32) string {
    return "node." + project_node_id(project_file(project), index)
}

fn deployed_record_gateway(project: string) void {
    deployed_set(project, "gateway", deploy_gateway_signature(deployed_plan(project)))
}

// deployed_node_reason says why a board is out of date: "" when it runs what
// is planned, or when it is not a board. A board programmed before signatures
// were kept is taken to run what is planned, once.
fn deployed_node_reason(project: string, index: u32) string {
    let plan: string = deployed_plan(project)
    if !deploy_is_board(plan, index) {
        return ""
    }
    let key: string = deployed_node_key(project, index)
    let recorded: string = deployed_get(project, key)
    let planned: string = deploy_node_signature(plan, index)
    if recorded == "" &&
        rho_str_eq(state_value_in(project_file(project), "status.node." + rho_int_to_str(index)), "programmed") {
        deployed_set(project, key, planned)
        return ""
    }
    return deploy_reason(recorded, planned)
}

// deployed_gateway_reason is the same for the gateway. A native gateway that
// runs is taken to run what is planned the first time it is asked.
fn deployed_gateway_reason(project: string) string {
    let plan: string = deployed_plan(project)
    let recorded: string = deployed_get(project, "gateway")
    let planned: string = deploy_gateway_signature(plan)
    if recorded == "" && rho_str_eq(state_value_in(project_file(project), "status.gateway"), "running") {
        deployed_set(project, "gateway", planned)
        return ""
    }
    return deploy_reason(recorded, planned)
}

// deployed_out_of_date are the boards of a project that differ from what they
// run, as "index\n" lines.
fn deployed_out_of_date(project: string) string {
    var out: string = ""
    let count: u32 = project_node_count_at(project_file(project))
    var index: u32 = 1
    while index <= count {
        if deployed_node_reason(project, index) != "" {
            out = out + rho_int_to_str(index) + "\n"
        }
        index = index + 1
    }
    return out
}

// deployed_reason_text is a reason (deploy_reason) as a page in `loc` shows it.
// The reason itself stays in English words, because code compares it and the
// domain tests read it; only what a person sees is translated.
fn deployed_reason_text(loc: string, reason: string) string {
    if reason == "" {
        return ""
    }
    if reason == "never programmed" {
        return mesh_t(loc, "deploy.never_programmed")
    }
    if reason == "changed" {
        return mesh_t(loc, "deploy.changed")
    }
    let suffix: string = " changed"
    let length: u32 = u32(rho_strlen(reason))
    if length <= u32(rho_strlen(suffix)) ||
        !rho_str_eq(rho_str_slice(reason, length - u32(rho_strlen(suffix)), u32(rho_strlen(suffix))), suffix) {
        return reason
    }
    var list: string = ""
    var rest: string = rho_str_slice(reason, 0, length - u32(rho_strlen(suffix)))
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, ", ")
        var words: string = rest
        if at < 0 {
            rest = ""
        } else {
            words = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 2, u32(rho_strlen(rest)) - u32(at) - 2)
        }
        if list != "" {
            list = list + ", "
        }
        list = list + deployed_segment_text(loc, words)
    }
    return mesh_fill(mesh_t(loc, "deploy.changed_list"), "list", list)
}

// deployed_segment_text is one of deploy_segment_words in `loc`.
fn deployed_segment_text(loc: string, words: string) string {
    var rest: string = DEPLOY_SEGMENTS
    while rest != "" {
        let label: string = deploy_words_next(rest)
        rest = deploy_words_rest(rest)
        if rho_str_eq(deploy_segment_words(label), words) {
            return mesh_t(loc, "deploy.segment." + label)
        }
    }
    return words
}
