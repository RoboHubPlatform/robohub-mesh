//
// @file health.rho
// @brief Each board's health from its gateway: kept beside the plan, shown on the board's Data tab, and a bad reset raised as an alert.
//
// @module mesh.health
// @project mesh
// @author Aurel Miron
// @date 2026-11-20
//
// SPDX-License-Identifier: MIT
