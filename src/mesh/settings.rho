module mesh.settings

fn mesh_settings_tab(req: Request) string {
    let tab: string = request_query_param(req, "tab")
    if tab == "" { return "general" }
    if rho_str_eq(tab, "alerts") || rho_str_eq(tab, "auth") ||
        rho_str_eq(tab, "gateway") || rho_str_eq(tab, "storage") ||
        rho_str_eq(tab, "logging") || rho_str_eq(tab, "configuration") {
        return tab
    }
    return "general"
}

fn mesh_settings_nav(req: Request, active: string) string {
    var out: string = "<nav class=\"vtabnav settings-tabs\">"
    let ids: string = "general,alerts,auth,gateway,storage,logging,configuration"
    let keys: string = "settings.tab.general,settings.tab.alerts,settings.tab.auth,settings.tab.gateway,settings.tab.storage,settings.tab.logging,settings.tab.configuration"
    while ids != "" {
        let id_at: i32 = rho_str_index_of(ids, ",")
        let key_at: i32 = rho_str_index_of(keys, ",")
        var id: string = ids
        var key: string = keys
        if id_at < 0 { ids = "" } else {
            id = rho_str_slice(ids, 0, u32(id_at))
            ids = rho_str_slice(ids, u32(id_at) + 1, u32(rho_strlen(ids)) - u32(id_at) - 1)
        }
        if key_at < 0 { keys = "" } else {
            key = rho_str_slice(keys, 0, u32(key_at))
            keys = rho_str_slice(keys, u32(key_at) + 1, u32(rho_strlen(keys)) - u32(key_at) - 1)
        }
        var css: string = ""
        if rho_str_eq(id, active) { css = " class=\"active\"" }
        out = out + "<a href=\"/settings?tab=" + id + "\"" + css + ">" + i18n_t(req, key) + "</a>"
    }
    return out + "</nav>"
}

// mesh_alert_enabled is a channel's on or off, as the form's select spells it.
fn mesh_alert_enabled(provider: string) string {
    if alert.enabled(provider) {
        return "true"
    }
    return "false"
}

// mesh_alert_list is the bound channels as a comma-separated list.
fn mesh_alert_list() string {
    var out: string = ""
    var rest: string = alert.providers()
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, "\n")
        var name: string = rest
        if at < 0 {
            rest = ""
        } else {
            name = rho_str_slice(rest, 0, u32(at))
            rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        }
        if name != "" {
            if out != "" {
                out = out + ", "
            }
            out = out + name
        }
    }
    return out
}

// mesh_alert_set records one field of the Alerts form as a channel's setting.
fn mesh_alert_set(body: string, provider: string, key: string, field: string) void {
    if !alert.configure(provider, key, device_trim(form_value(body, field))) {
        warn("mesh", "the alert setting " + provider + "." + key + " could not be saved")
    }
}

fn mesh_settings_form(req: Request, tab: string) string {
    if rho_str_eq(tab, "logging") {
        return log_settings_form("mesh", "/settings?tab=logging",
            i18n_locale(req))
    }
    if rho_str_eq(tab, "alerts") {
        // Each channel's settings are the binding's: the defaults in module.yml,
        // changed here for this installation.
        let on_off: string = "true|" + i18n_t(req, "settings.alerts.on") + ",false|" + i18n_t(req, "settings.alerts.off")
        let levels: string = "INFO|INFO,WARNING|WARNING,ERROR|ERROR,CRITICAL|CRITICAL"
        var fields: FormField[9]
        fields[0] = FormField{ "log_path", "text", i18n_t(req, "settings.alerts.log_path"), "",
            "~/.rho/mesh/alerts.log", false, "", "", alert.config("robohub-provider-log", "path"), "", "" }
        fields[1] = FormField{ "log_threshold", "select", i18n_t(req, "settings.alerts.threshold"), "",
            "", false, "", levels, alert.config("robohub-provider-log", "severity_threshold"), "", "" }
        fields[2] = FormField{ "email_enabled", "select", i18n_t(req, "settings.alerts.email_enabled"), "",
            "", false, "", on_off, mesh_alert_enabled("robohub-provider-email"), "", "" }
        fields[3] = FormField{ "email_to", "text", i18n_t(req, "settings.alerts.email_to"), "",
            "ops@example.com", false, "", "", alert.config("robohub-provider-email", "to_address"), "", "" }
        fields[4] = FormField{ "email_threshold", "select", i18n_t(req, "settings.alerts.email_threshold"), "",
            "", false, "", levels, alert.config("robohub-provider-email", "severity_threshold"), "", "" }
        fields[5] = FormField{ "telegram_enabled", "select", i18n_t(req, "settings.alerts.telegram_enabled"), "",
            "", false, "", on_off, mesh_alert_enabled("robohub-provider-telegram"), "", "" }
        fields[6] = FormField{ "telegram_chat", "text", i18n_t(req, "settings.alerts.telegram_chat"), "",
            "", false, "", "", alert.config("robohub-provider-telegram", "chat_id"), "", "" }
        fields[7] = FormField{ "telegram_token", "password", i18n_t(req, "settings.alerts.telegram_token"), "",
            "", false, "", "", alert.config("robohub-provider-telegram", "bot_token"), "", "" }
        fields[8] = FormField{ "telegram_threshold", "select", i18n_t(req, "settings.alerts.telegram_threshold"), "",
            "", false, "", levels, alert.config("robohub-provider-telegram", "severity_threshold"), "", "" }
        return forms_open(fields, 9, "/settings?tab=alerts",
            i18n_t(req, "settings.save"), i18n_locale(req))
    }
    if rho_str_eq(tab, "storage") {
        var fields: FormField[8]
        fields[0] = FormField{ "raw_days", "text", i18n_t(req, "settings.storage.raw_days"), "",
            "14", false, "", "", settings_get("telemetry.raw_days", "14"), "", "numeric" }
        fields[1] = FormField{ "minute_days", "text", i18n_t(req, "settings.storage.minute_days"), "",
            "90", false, "", "", settings_get("telemetry.minute_days", "90"), "", "numeric" }
        fields[2] = FormField{ "hour_days", "text", i18n_t(req, "settings.storage.hour_days"), "",
            "1825", false, "", "", settings_get("telemetry.hour_days", "1825"), "", "numeric" }
        fields[3] = FormField{ "fault_days", "text", i18n_t(req, "settings.storage.fault_days"), "",
            "365", false, "", "", settings_get("telemetry.fault_days", "365"), "", "numeric" }
        fields[4] = FormField{ "checkpoint_minutes", "text", i18n_t(req, "settings.storage.checkpoint"), "",
            "5", false, "", "", settings_get("telemetry.checkpoint_minutes", "5"), "", "numeric" }
        fields[5] = FormField{ "prune_hours", "text", i18n_t(req, "settings.storage.prune_hours"), "",
            "6", false, "", "", settings_get("telemetry.prune_hours", "6"), "", "numeric" }
        fields[6] = FormField{ "vacuum_mode", "select", i18n_t(req, "settings.storage.vacuum"), "",
            "", false, "", "off|" + i18n_t(req, "settings.storage.vacuum_off") +
            ",incremental|" + i18n_t(req, "settings.storage.vacuum_incremental") +
            ",full|" + i18n_t(req, "settings.storage.vacuum_full"),
            settings_get("telemetry.vacuum_mode", "incremental"), "", "" }
        fields[7] = FormField{ "backoff_max_s", "text", i18n_t(req, "settings.storage.backoff"), "",
            "60", false, "", "", settings_get("telemetry.backoff_max_s", "60"), "", "numeric" }
        return forms_open(fields, 8, "/settings?tab=storage",
            i18n_t(req, "settings.save"), i18n_locale(req))
    }
    if rho_str_eq(tab, "auth") {
        return "<dl class=\"settings\"><dt>Issuer</dt><dd>keeper</dd>" +
            "<dt>Mode</dt><dd>direct</dd>" +
            "<dt>Login URL</dt><dd><code>http://127.0.0.1:19090/auth/login</code></dd></dl>"
    }
    if rho_str_eq(tab, "gateway") {
        return "<dl class=\"settings\"><dt>Provider</dt><dd>mesh-gateway</dd>" +
            "<dt>Route</dt><dd>/mesh</dd><dt>Port</dt><dd>8478</dd>" +
            "<dt>Current project</dt><dd>" + escape_html(current_project()) + "</dd></dl>"
    }
    if rho_str_eq(tab, "configuration") {
        return "<dl class=\"settings\"><dt>Application</dt><dd>mesh</dd>" +
            "<dt>Registry</dt><dd><code>" + escape_html(mesh_registry_source()) + "</code></dd>" +
            "<dt>Plugins</dt><dd>robohub-auth</dd>" +
            "<dt>Alert channels</dt><dd>" + escape_html(mesh_alert_list()) + "</dd></dl>"
    }
    var fields: FormField[1]
    fields[0] = FormField{ "tabs", "select", i18n_t(req, "settings.orientation"), "",
        "", false, "", "vertical|" + i18n_t(req, "settings.orientation.vertical") +
        ",horizontal|" + i18n_t(req, "settings.orientation.horizontal"),
        settings_get("ui.tabs", "vertical"), "", "" }
    return forms_open(fields, 1, "/settings?tab=general",
        i18n_t(req, "settings.save"), i18n_locale(req))
}

fn mesh_settings_page_message(req: Request, message: string) Response {
    let tab: string = mesh_settings_tab(req)
    var notice: string = ""
    if message != "" {
        notice = "<p class=\"notice\">" + escape_html(message) + "</p>"
    }
    let body: string = template_fill(template_get("settings"),
        i18n_vars(req) +
        vars("notice", notice) +
        vars("nav", mesh_settings_nav(req, tab)) +
        vars("tab_content", mesh_settings_form(req, tab)))
    return page(req, i18n_t(req, "page.settings"), body)
}

fn mesh_settings_page(req: Request) Response {
    return mesh_settings_page_message(req, "")
}

fn mesh_settings_save(req: Request) Response {
    if !mesh_may(req, "", true) {
        return mesh_denied(req)
    }
    let body: string = request_body(req)
    let tab: string = mesh_settings_tab(req)
    if !forms_csrf_ok(body) {
        return mesh_settings_page_message(req, i18n_t(req, "settings.csrf_refused"))
    }
    if rho_str_eq(tab, "logging") {
        if log_settings_save("mesh", body) {
            info("mesh", "logging settings updated")
        }
        return redirect("/settings?tab=logging")
    }
    if rho_str_eq(tab, "storage") {
        settings_set("telemetry.raw_days", device_trim(form_value(body, "raw_days")))
        settings_set("telemetry.minute_days", device_trim(form_value(body, "minute_days")))
        settings_set("telemetry.hour_days", device_trim(form_value(body, "hour_days")))
        settings_set("telemetry.fault_days", device_trim(form_value(body, "fault_days")))
        settings_set("telemetry.checkpoint_minutes", device_trim(form_value(body, "checkpoint_minutes")))
        settings_set("telemetry.prune_hours", device_trim(form_value(body, "prune_hours")))
        settings_set("telemetry.vacuum_mode", device_trim(form_value(body, "vacuum_mode")))
        settings_set("telemetry.backoff_max_s", device_trim(form_value(body, "backoff_max_s")))
        return redirect("/settings?tab=storage")
    }
    if rho_str_eq(tab, "alerts") {
        mesh_alert_set(body, "robohub-provider-log", "path", "log_path")
        mesh_alert_set(body, "robohub-provider-log", "severity_threshold", "log_threshold")
        mesh_alert_set(body, "robohub-provider-email", "enabled", "email_enabled")
        mesh_alert_set(body, "robohub-provider-email", "to_address", "email_to")
        mesh_alert_set(body, "robohub-provider-email", "severity_threshold", "email_threshold")
        mesh_alert_set(body, "robohub-provider-telegram", "enabled", "telegram_enabled")
        mesh_alert_set(body, "robohub-provider-telegram", "chat_id", "telegram_chat")
        mesh_alert_set(body, "robohub-provider-telegram", "bot_token", "telegram_token")
        mesh_alert_set(body, "robohub-provider-telegram", "severity_threshold", "telegram_threshold")
        return redirect("/settings?tab=alerts")
    }
    settings_set("ui.tabs", device_trim(form_value(body, "tabs")))
    return redirect("/settings?tab=general")
}
