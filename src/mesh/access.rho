module mesh.access

// What the person signed in may do in Mesh, from the grants the keeper put in
// their ticket (the X-Rho-Scopes the auth middleware sets). The rule itself is
// mesh_grant in domain/access.rho; this is the part only a request knows: the
// verified audience and scopes, and whether its subject is revoked in the mesh
// it is about. The middleware already refuses a change from someone whose grants
// all end in ":read".

import std.web.http

fn mesh_scopes(req: Request) string {
    return header_str(req, "X-Rho-Scopes")
}

fn mesh_audience(req: Request) string {
    return header_str(req, "X-Rho-Aud")
}

// mesh_may is whether a request may read (`write` false) or change (`write`
// true) a mesh; the mesh "" is Mesh as a whole. A request the middleware did not
// authenticate (no audience) is refused like one with no grant: the routes that
// are public on purpose are the middleware's skip_paths and do not ask, so a
// path the middleware were to leave unguarded is not opened by it.
// @req MESH-0012, MESH-API-0001, MESH-API-0006
fn mesh_may(req: Request, project: string, write: bool) bool {
    let audience: string = mesh_audience(req)
    let scopes: string = mesh_scopes(req)
    if audience == "" || scopes == "" {
        return false
    }
    var revoked: bool = false
    if project != "" {
        revoked = mesh_subject_revoked(project, header_str(req, "X-Rho-Subject"))
    }
    return mesh_grant(audience, scopes, project, write, revoked)
}

fn mesh_denied(req: Request) Response {
    if has_header(req, "HX-Request") || rho_str_index_of(request_path(req), "/api/") >= 0 {
        return Response{ 403, "{\"ok\":false,\"error\":\"your grants do not allow that\"}", "application/json", "" }
    }
    return html(403, mesh_shell(req, i18n_t(req, "access.title"),
        "<section class=\"mesh-form-panel page-panel\"><h1>" + i18n_t(req, "access.title") + "</h1><p>" +
        escape_html(i18n_t(req, "access.denied")) + "</p><p><a href=\"/mesh\">" + i18n_t(req, "access.back") + "</a></p></section>"))
}
